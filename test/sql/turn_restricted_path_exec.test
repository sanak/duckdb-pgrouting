# name: test/sql/turn_restricted_path_exec.test
# description: _pgr_exec with the turn-restricted path driver: KSP numbering, strict, K and path checks
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/edges.csv');

statement ok
CREATE TABLE restrictions AS
SELECT id, CAST(path AS BIGINT[]) AS path, CAST(cost AS DOUBLE) AS cost
FROM read_csv_auto('test/data/sampledata/restrictions.csv');

statement ok
CREATE TABLE er AS
SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
       (SELECT list(r) FROM (SELECT path, cost FROM restrictions) r) AS restrictions;

# Upstream's q1, row for row.
query IIIIIIIRR
SELECT seq, path_id, path_seq, start_vid, end_vid, node, edge, cost, agg_cost
FROM _pgr_exec((SELECT edges, restrictions, [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'SELECT path, cost FROM restrictions', driver := 'turn_restricted_path', k := 3)
ORDER BY seq;
----
1	1	1	0	8	3	7	1	inf
2	1	2	0	8	7	10	1	1
3	1	3	0	8	8	-1	0	2

# Upstream's q2: strict drops a path that breaks a restriction.
query I
SELECT count(*)
FROM _pgr_exec((SELECT edges, restrictions, [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'SELECT path, cost FROM restrictions', driver := 'turn_restricted_path', k := 3,
  strict := true);
----
0

# Upstream's q3: undirected, a path that breaks nothing.
query IRI
SELECT count(*), max(agg_cost), count(*) FILTER (WHERE isinf(agg_cost))
FROM _pgr_exec((SELECT edges, restrictions, [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'SELECT path, cost FROM restrictions', driver := 'turn_restricted_path', k := 3,
  directed := false);
----
7	6	0

# Upstream's q4: every candidate, not only the first (heap_paths, stop_on_first := false). path_id
# numbers the paths as src/ksp/turnRestrictedPath.c does; start_vid is the route index.
query IIIR
SELECT path_id, start_vid, count(*), max(agg_cost)
FROM _pgr_exec((SELECT edges, restrictions, [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'SELECT path, cost FROM restrictions', driver := 'turn_restricted_path', k := 3,
  directed := false, heap_paths := true, stop_on_first := false)
GROUP BY ALL ORDER BY 1;
----
1	0	7	6
2	1	7	6

# Start = end, and an absent vertex, find nothing.
query I
SELECT count(*)
FROM _pgr_exec((SELECT edges, restrictions, [3]::BIGINT[] AS starts, [3]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'SELECT path, cost FROM restrictions', driver := 'turn_restricted_path', k := 3);
----
0

query I
SELECT count(*)
FROM _pgr_exec((SELECT edges, restrictions, [3]::BIGINT[] AS starts, [999]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'SELECT path, cost FROM restrictions', driver := 'turn_restricted_path', k := 3);
----
0

# K = 0 is accepted (upstream: stop at the first path that breaks no restriction).
statement ok
SELECT count(*)
FROM _pgr_exec((SELECT edges, restrictions, [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'SELECT path, cost FROM restrictions', driver := 'turn_restricted_path', k := 0);

# K < 0: src/ksp/turnRestrictedPath.c raises, unlike src/ksp/ksp.c.
statement error
SELECT count(*)
FROM _pgr_exec((SELECT edges, restrictions, [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'SELECT path, cost FROM restrictions', driver := 'turn_restricted_path', k := -1);
----
Invalid Input Error: Invalid value of 'K'
HINT: Valid value are greater than 0

# A NULL or empty restriction path would reach undefined behaviour in upstream's Rule (it takes the
# path's last element); it is refused instead. A NULL element is get_array's error, as for pgr_trsp.
statement error
SELECT count(*)
FROM _pgr_exec(
  (SELECT edges, (SELECT list(r) FROM (SELECT path, cost FROM restrictions UNION ALL SELECT []::BIGINT[], 5.0) r)
            AS restrictions,
          [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'with an empty path', driver := 'turn_restricted_path', k := 3);
----
Unexpected NULL or empty array in column path

statement error
SELECT count(*)
FROM _pgr_exec(
  (SELECT edges, (SELECT list(r) FROM (SELECT path, cost FROM restrictions UNION ALL SELECT NULL::BIGINT[], 5.0) r)
            AS restrictions,
          [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'with a NULL path', driver := 'turn_restricted_path', k := 3);
----
Unexpected NULL or empty array in column path

statement error
SELECT count(*)
FROM _pgr_exec(
  (SELECT edges, (SELECT list(r) FROM (SELECT path, cost FROM restrictions UNION ALL SELECT [7, NULL]::BIGINT[], 5.0) r)
            AS restrictions,
          [3]::BIGINT[] AS starts, [8]::BIGINT[] AS ends FROM er),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  restrictions_sql := 'with a NULL element', driver := 'turn_restricted_path', k := 3);
----
NULL value found in Array!

# STRICT: a NULL argument means the function is never entered, and K is not checked.
query I
SELECT count(*) FROM _pgr_exec((SELECT NULL AS edges), edges_sql := '', driver := 'turn_restricted_path', k := -1,
  null_input := true);
----
0
