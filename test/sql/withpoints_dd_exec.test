     FROM wpdd_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  points_sql := 'SELECT pid, edge_id, fraction, side FROM pois',
  driver := 'with_points_dd', distance := -1.0, driving_side := 'x',
  directed := true, details := true, equicost := false);
----
Invalid value of 'driving side'

statement error
SELECT * FROM _pgr_exec(
  (SELECT NULL AS edges, [-1]::BIGINT[] AS roots, points, edges_of_points, edges_no_points
     FROM wpdd_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  points_sql := 'SELECT pid, edge_id, fraction, side FROM pois',
  driver := 'with_points_dd', distance := 3.3, driving_side := '',
  directed := true, details := true, equicost := false);
----
Invalid value of 'driving side'

statement error
SELECT * FROM _pgr_exec(
  (SELECT NULL AS edges, [-1]::BIGINT[] AS roots, points, edges_of_points, edges_no_points
     FROM wpdd_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  points_sql := 'SELECT pid, edge_id, fraction, side FROM pois',
  driver := 'with_points_dd', distance := -1.0, driving_side := 'r',
  directed := true, details := true, equicost := false);
----
Invalid Input Error: Negative value found on 'distance'
HINT: Must be positive

# STRICT: nothing is checked when an argument is NULL.
query I
SELECT count(*) FROM _pgr_exec((SELECT NULL AS edges), edges_sql := '', points_sql := 'SELECT 1',
  driver := 'with_points_dd', driving_side := 'x', null_input := true);
----
0
