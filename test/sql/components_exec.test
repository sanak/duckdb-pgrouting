# name: test/sql/components_exec.test
# description: _pgr_exec with the component drivers: IDS, PAIRS and ID_VALUE rows, the self-loop guard
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

statement ok
CREATE TABLE ex AS SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges;

statement ok
CREATE MACRO q() AS 'SELECT id, source, target, cost, reverse_cost FROM edges';

# Small graphs, each one list of edges in id order.
statement ok
CREATE TABLE g (name VARCHAR, id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO g VALUES
  ('path', 1, 1, 2, 1, 1), ('path', 2, 2, 3, 1, 1), ('path', 3, 3, 4, 1, 1),
  ('one way', 1, 1, 2, 1, -1), ('one way', 2, 2, 3, 1, -1), ('one way', 3, 3, 4, 1, -1),
  ('two costs', 1, 1, 2, 1, 1), ('two costs', 2, 2, 3, 1, 2), ('two costs', 3, 3, 4, 1, 1),
  ('triangle and tail', 1, 1, 2, 1, 1), ('triangle and tail', 2, 2, 3, 1, 1),
  ('triangle and tail', 3, 3, 1, 1, 1), ('triangle and tail', 4, 3, 4, 1, 1),
  ('self-loop and edge', 1, 1, 1, 1, 1), ('self-loop and edge', 2, 1, 2, 1, 1),
  ('self-loop', 1, 1, 1, 1, 1),
  ('two self-loops', 1, 2, 2, -1, 1), ('two self-loops', 2, 1, 1, 1, -1),
  ('two edges', 1, 1, 2, 1, 1), ('two edges', 2, 3, 4, 1, 1);

statement ok
CREATE TABLE graphs AS SELECT name, list({'id': id, 'source': source, 'target': target, 'cost': cost,
  'reverse_cost': reverse_cost} ORDER BY id) AS edges FROM g GROUP BY name;

# The IDS shape: upstream's int64_t rows, numbered from 1.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(),
  driver := 'articulation_points'));
----
seq	BIGINT
id	BIGINT

# Upstream's articulationPoints and bridges q1, ascending as the drivers return them.
query II
SELECT seq, id FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(), driver := 'articulation_points') ORDER BY seq;
----
1	3
2	6
3	7
4	8

query II
SELECT seq, id FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(), driver := 'bridges') ORDER BY seq;
----
1	1
2	6
3	7
4	14
5	17
6	18

# The PAIRS shape, as pgr_connectedComponents returns it; biconnectedComponents' node is an edge id.
# Each component is numbered by its smallest member (upstream's q1 for both).
query III
SELECT seq, component, node FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(),
  driver := 'biconnected_components') ORDER BY seq;
----
1	1	1
2	2	2
3	2	3
4	2	4
5	2	5
6	2	8
7	2	9
8	2	10
9	2	11
10	2	12
11	2	13
12	2	15
13	2	16
14	6	6
15	7	7
16	14	14
17	17	17
18	18	18

query III
SELECT seq, component, node FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(),
  driver := 'strong_components') ORDER BY seq;
----
1	1	1
2	1	3
3	1	5
4	1	6
5	1	7
6	1	8
7	1	9
8	1	10
9	1	11
10	1	12
11	1	15
12	1	16
13	1	17
14	2	2
15	2	4
16	13	13
17	13	14

# The ID_VALUE shape: an II_t_rt pair (d1.id, d2.value) with a seq.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(),
  driver := 'make_connected'));
----
seq	BIGINT
id	BIGINT
value	BIGINT

# The two edges that join the sample graph's three components. Which vertices they join depends on
# the order the edges are read in: in id order, 9 -> 2 and 4 -> 13 (upstream's transcript, read in
# another order, shows 5 -> 2 and 4 -> 13).
query III
SELECT seq, id, value FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(), driver := 'make_connected') ORDER BY seq;
----
1	9	2
2	4	13

# Every graph read as undirected, as upstream reads it. An edge whose cost and reverse_cost differ
# enters the graph twice, as two parallel edges ('two costs', edge 2): never a bridge, listed twice
# by biconnectedComponents. With a self-loop at vertex 1, upstream finds no bridge at all. Each
# input row is a literal: _pgr_exec's named arguments must be constants, and it expects one row.
query TT
SELECT 'one way', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'one way'),
  edges_sql := 'one way', driver := 'articulation_points'))
UNION ALL SELECT 'path', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'path'),
  edges_sql := 'path', driver := 'articulation_points'))
UNION ALL SELECT 'self-loop', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop'),
  edges_sql := 'self-loop', driver := 'articulation_points'))
UNION ALL SELECT 'self-loop and edge', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop and edge'),
  edges_sql := 'self-loop and edge', driver := 'articulation_points'))
UNION ALL SELECT 'triangle and tail', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'triangle and tail'),
  edges_sql := 'triangle and tail', driver := 'articulation_points'))
UNION ALL SELECT 'two costs', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two costs'),
  edges_sql := 'two costs', driver := 'articulation_points'))
UNION ALL SELECT 'two edges', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two edges'),
  edges_sql := 'two edges', driver := 'articulation_points'))
UNION ALL SELECT 'two self-loops', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two self-loops'),
  edges_sql := 'two self-loops', driver := 'articulation_points'))
ORDER BY 1;
----
one way	2 3
path	2 3
self-loop	NULL
self-loop and edge	NULL
triangle and tail	3
two costs	2 3
two edges	NULL
two self-loops	NULL

# The same graphs' bridges.
query TT
SELECT 'one way', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'one way'),
  edges_sql := 'one way', driver := 'bridges'))
UNION ALL SELECT 'path', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'path'),
  edges_sql := 'path', driver := 'bridges'))
UNION ALL SELECT 'self-loop', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop'),
  edges_sql := 'self-loop', driver := 'bridges'))
UNION ALL SELECT 'self-loop and edge', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop and edge'),
  edges_sql := 'self-loop and edge', driver := 'bridges'))
UNION ALL SELECT 'triangle and tail', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'triangle and tail'),
  edges_sql := 'triangle and tail', driver := 'bridges'))
UNION ALL SELECT 'two costs', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two costs'),
  edges_sql := 'two costs', driver := 'bridges'))
UNION ALL SELECT 'two edges', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two edges'),
  edges_sql := 'two edges', driver := 'bridges'))
UNION ALL SELECT 'two self-loops', (SELECT string_agg(id::VARCHAR, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two self-loops'),
  edges_sql := 'two self-loops', driver := 'bridges'))
ORDER BY 1;
----
one way	1 2 3
path	1 2 3
self-loop	NULL
self-loop and edge	NULL
triangle and tail	4
two costs	1 3
two edges	1 2
two self-loops	NULL

# component:edge. 'self-loop' and 'two self-loops' have no biconnected component: the guard answers
# them with no rows (upstream would index an empty vector and crash).
query TT
SELECT 'one way', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'one way'),
  edges_sql := 'one way', driver := 'biconnected_components'))
UNION ALL SELECT 'path', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'path'),
  edges_sql := 'path', driver := 'biconnected_components'))
UNION ALL SELECT 'self-loop', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop'),
  edges_sql := 'self-loop', driver := 'biconnected_components'))
UNION ALL SELECT 'self-loop and edge', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop and edge'),
  edges_sql := 'self-loop and edge', driver := 'biconnected_components'))
UNION ALL SELECT 'triangle and tail', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'triangle and tail'),
  edges_sql := 'triangle and tail', driver := 'biconnected_components'))
UNION ALL SELECT 'two costs', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two costs'),
  edges_sql := 'two costs', driver := 'biconnected_components'))
UNION ALL SELECT 'two edges', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two edges'),
  edges_sql := 'two edges', driver := 'biconnected_components'))
UNION ALL SELECT 'two self-loops', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two self-loops'),
  edges_sql := 'two self-loops', driver := 'biconnected_components'))
ORDER BY 1;
----
one way	1:1 2:2 3:3
path	1:1 2:2 3:3
self-loop	NULL
self-loop and edge	1:1 1:2
triangle and tail	1:1 1:2 1:3 4:4
two costs	1:1 2:2 2:2 2:3
two edges	1:1 2:2
two self-loops	NULL

# component:node, the graph read as directed: 'one way' falls apart into single vertices.
query TT
SELECT 'one way', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'one way'),
  edges_sql := 'one way', driver := 'strong_components'))
UNION ALL SELECT 'path', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'path'),
  edges_sql := 'path', driver := 'strong_components'))
UNION ALL SELECT 'self-loop', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop'),
  edges_sql := 'self-loop', driver := 'strong_components'))
UNION ALL SELECT 'self-loop and edge', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop and edge'),
  edges_sql := 'self-loop and edge', driver := 'strong_components'))
UNION ALL SELECT 'triangle and tail', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'triangle and tail'),
  edges_sql := 'triangle and tail', driver := 'strong_components'))
UNION ALL SELECT 'two costs', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two costs'),
  edges_sql := 'two costs', driver := 'strong_components'))
UNION ALL SELECT 'two edges', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two edges'),
  edges_sql := 'two edges', driver := 'strong_components'))
UNION ALL SELECT 'two self-loops', (SELECT string_agg(component || ':' || node, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two self-loops'),
  edges_sql := 'two self-loops', driver := 'strong_components'))
ORDER BY 1;
----
one way	1:1 2:2 3:3 4:4
path	1:1 1:2 1:3 1:4
self-loop	1:1
self-loop and edge	1:1 1:2
triangle and tail	1:1 1:2 1:3 1:4
two costs	1:1 1:2 1:3 1:4
two edges	1:1 1:2 3:3 3:4
two self-loops	1:1 2:2

# id:value, the edges makeConnected adds; a connected graph needs none.
query TT
SELECT 'one way', (SELECT string_agg(id || ':' || value, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'one way'),
  edges_sql := 'one way', driver := 'make_connected'))
UNION ALL SELECT 'path', (SELECT string_agg(id || ':' || value, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'path'),
  edges_sql := 'path', driver := 'make_connected'))
UNION ALL SELECT 'self-loop', (SELECT string_agg(id || ':' || value, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop'),
  edges_sql := 'self-loop', driver := 'make_connected'))
UNION ALL SELECT 'self-loop and edge', (SELECT string_agg(id || ':' || value, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'self-loop and edge'),
  edges_sql := 'self-loop and edge', driver := 'make_connected'))
UNION ALL SELECT 'triangle and tail', (SELECT string_agg(id || ':' || value, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'triangle and tail'),
  edges_sql := 'triangle and tail', driver := 'make_connected'))
UNION ALL SELECT 'two costs', (SELECT string_agg(id || ':' || value, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two costs'),
  edges_sql := 'two costs', driver := 'make_connected'))
UNION ALL SELECT 'two edges', (SELECT string_agg(id || ':' || value, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two edges'),
  edges_sql := 'two edges', driver := 'make_connected'))
UNION ALL SELECT 'two self-loops', (SELECT string_agg(id || ':' || value, ' ' ORDER BY seq) FROM _pgr_exec((SELECT edges FROM graphs WHERE name = 'two self-loops'),
  edges_sql := 'two self-loops', driver := 'make_connected'))
ORDER BY 1;
----
one way	NULL
path	NULL
self-loop	NULL
self-loop and edge	NULL
triangle and tail	NULL
two costs	NULL
two edges	2:3
two self-loops	2:1

# An empty edge query: upstream's notice, no rows.
query IIIII
SELECT
  (SELECT count(*) FROM _pgr_exec((SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost
     FROM edges WHERE id < 0) e) AS edges), edges_sql := 'empty', driver := 'articulation_points')),
  (SELECT count(*) FROM _pgr_exec((SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost
     FROM edges WHERE id < 0) e) AS edges), edges_sql := 'empty', driver := 'bridges')),
  (SELECT count(*) FROM _pgr_exec((SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost
     FROM edges WHERE id < 0) e) AS edges), edges_sql := 'empty', driver := 'biconnected_components')),
  (SELECT count(*) FROM _pgr_exec((SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost
     FROM edges WHERE id < 0) e) AS edges), edges_sql := 'empty', driver := 'strong_components')),
  (SELECT count(*) FROM _pgr_exec((SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost
     FROM edges WHERE id < 0) e) AS edges), edges_sql := 'empty', driver := 'make_connected'));
----
0	0	0	0	0

# More than one 2048-row chunk: seq continues across chunks. A path of 3000 vertices has 2998
# articulation points (its inner vertices) and 2999 bridges (all its edges); 3000 separate edges
# need 2999 more, each joining the last vertex of one to the first of the next.
statement ok
CREATE TABLE long_path AS SELECT (SELECT list({'id': i, 'source': i, 'target': i + 1, 'cost': 1.0,
  'reverse_cost': 1.0} ORDER BY i) FROM range(1, 3000) t(i)) AS edges;

statement ok
CREATE TABLE many_pairs AS SELECT (SELECT list({'id': i + 1, 'source': 2 * i + 1, 'target': 2 * i + 2, 'cost': 1.0,
  'reverse_cost': 1.0} ORDER BY i) FROM range(3000) t(i)) AS edges;

query IIII
SELECT count(*), min(id), max(id), count(*) FILTER (WHERE seq <> id - 1)
FROM _pgr_exec((SELECT edges FROM long_path), edges_sql := 'long path', driver := 'articulation_points');
----
2998	2	2999	0

query IIII
SELECT count(*), min(id), max(id), count(*) FILTER (WHERE seq <> id)
FROM _pgr_exec((SELECT edges FROM long_path), edges_sql := 'long path', driver := 'bridges');
----
2999	1	2999	0

query IIIII
SELECT count(*), min(seq), max(seq), count(DISTINCT seq),
       count(*) FILTER (WHERE value <> id + 1 OR id % 2 <> 0 OR seq <> id // 2)
FROM _pgr_exec((SELECT edges FROM many_pairs), edges_sql := 'many pairs', driver := 'make_connected');
----
2999	1	2999	2999	0

# The guard reads the edges only when it can; anything else is left to upstream's own column checks.
statement error
SELECT * FROM _pgr_exec((SELECT (SELECT list(e) FROM (SELECT 1 AS source, 1 AS target, 1.0 AS cost) e) AS edges),
  edges_sql := 'self-loop without id', driver := 'biconnected_components');
----
Column 'id' not Found

statement error
SELECT * FROM _pgr_exec((SELECT (SELECT list(e) FROM (SELECT source, target, cost, reverse_cost FROM edges) e) AS edges),
  edges_sql := 'no id', driver := 'articulation_points');
----
Column 'id' not Found

# STRICT: a NULL argument means the function is never entered.
query I
SELECT count(*) FROM _pgr_exec((SELECT NULL AS edges), edges_sql := '', driver := 'make_connected', null_input := true);
----
0
