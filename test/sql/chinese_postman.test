# name: test/sql/chinese_postman.test
# description: pgr_chinesePostman and pgr_chinesePostmanCost: tours, their order-free facts, the start vertex upstream crashes on
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_chinesePostman('SELECT * FROM edges'));
----
seq	INTEGER
node	BIGINT
edge	BIGINT
cost	DOUBLE
agg_cost	DOUBLE

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_chinesePostmanCost('SELECT * FROM edges'));
----
pgr_chinesepostmancost	DOUBLE

# Upstream's q2, row for row.
query IIIRR
SELECT * FROM pgr_chinesePostman('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id IN (9, 11, 13, 15)');
----
1	11	9	1	0
2	16	9	1	1
3	11	11	1	2
4	12	13	1	3
5	17	15	1	4
6	16	15	1	5
7	17	15	1	6
8	16	9	1	7
9	11	-1	0	8

# Upstream's q1, whose tour starts at the first row's source and so depends on the edge order: 35
# rows, a closed walk over the same edges, each step along an edge between its two nodes, total 34.
statement ok
CREATE TABLE q1 AS SELECT * FROM pgr_chinesePostman('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 17');

query IRTT
SELECT count(*), max(agg_cost), list(edge ORDER BY edge),
       (SELECT node FROM q1 WHERE seq = 1) = (SELECT node FROM q1 WHERE seq = 35)
FROM q1;
----
35	34	[-1, 1, 1, 2, 3, 3, 4, 4, 4, 5, 6, 6, 7, 7, 8, 8, 9, 9, 10, 10, 10, 11, 12, 13, 13, 14, 14, 15, 15, 15, 15, 16, 16, 16, 16]	true

query I
SELECT count(*) FROM q1 a JOIN q1 b ON b.seq = a.seq + 1 JOIN edges e ON e.id = a.edge
WHERE NOT ((e.source = a.node AND e.target = b.node) OR (e.target = a.node AND e.source = b.node));
----
0

# The Cost form (upstream's q1 and q2).
query RR
SELECT pgr_chinesePostmanCost('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 17'),
       pgr_chinesePostmanCost('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id IN (9, 11, 13, 15)');
----
34	8

# The first row's source lies on no direction with a positive cost. Upstream crashes on these; here
# they answer no tour and no cost, as upstream does for such a start whenever it does not crash.
query IT
SELECT (SELECT count(*) FROM pgr_chinesePostman('SELECT * FROM (VALUES (1, 5, 6, -1.0, -1.0), (2, 1, 2, 1.0, 1.0))
          t(id, source, target, cost, reverse_cost)')),
       pgr_chinesePostmanCost('SELECT * FROM (VALUES (1, 5, 6, -1.0, -1.0), (2, 1, 2, 1.0, 1.0))
          t(id, source, target, cost, reverse_cost)') IS NULL;
----
0	true

query IT
SELECT (SELECT count(*) FROM pgr_chinesePostman('SELECT 1 AS id, 1 AS source, 2 AS target, -1.0 AS cost, -1.0 AS reverse_cost')),
       pgr_chinesePostmanCost('SELECT 1 AS id, 1 AS source, 2 AS target, 0.0 AS cost, 0.0 AS reverse_cost') IS NULL;
----
0	true

# A graph whose first row is fine but which cannot be balanced reaches the driver: no tour, no cost.
query IT
SELECT (SELECT count(*) FROM pgr_chinesePostman('SELECT 1 AS id, 1 AS source, 2 AS target, 1.0 AS cost, -1.0 AS reverse_cost')),
       pgr_chinesePostmanCost('SELECT 1 AS id, 1 AS source, 2 AS target, 1.0 AS cost, -1.0 AS reverse_cost') IS NULL;
----
0	true

# Upstream's own inconsistencies, kept: two separate cycles have a cost but no tour; among parallel
# edges the tour always takes the cheapest while the cost counts each one.
query IR
SELECT (SELECT count(*) FROM pgr_chinesePostman('SELECT * FROM (VALUES (1, 1, 2, 1.0, 1.0), (2, 3, 4, 1.0, 1.0))
          t(id, source, target, cost, reverse_cost)')),
       pgr_chinesePostmanCost('SELECT * FROM (VALUES (1, 1, 2, 1.0, 1.0), (2, 3, 4, 1.0, 1.0))
          t(id, source, target, cost, reverse_cost)');
----
0	4

query RR
SELECT (SELECT max(agg_cost) FROM pgr_chinesePostman('SELECT * FROM (VALUES (1, 1, 2, 1.0, -1.0), (2, 1, 2, 2.0, -1.0),
          (3, 2, 1, 5.0, -1.0)) t(id, source, target, cost, reverse_cost)')),
       pgr_chinesePostmanCost('SELECT * FROM (VALUES (1, 1, 2, 1.0, -1.0), (2, 1, 2, 2.0, -1.0),
          (3, 2, 1, 5.0, -1.0)) t(id, source, target, cost, reverse_cost)');
----
12	13

# Nothing to do, and STRICT.
query ITIT
SELECT (SELECT count(*) FROM pgr_chinesePostman('SELECT * FROM edges WHERE id < 0')),
       pgr_chinesePostmanCost('SELECT * FROM edges WHERE id < 0') IS NULL,
       (SELECT count(*) FROM pgr_chinesePostman(NULL::VARCHAR)),
       pgr_chinesePostmanCost(NULL::VARCHAR) IS NULL;
----
0	true	0	true

statement error
SELECT * FROM pgr_chinesePostman('SELECT id, source, target FROM edges');
----
Column 'cost' not Found

query TT
SELECT function_type, parameters FROM duckdb_functions()
WHERE function_name = 'pgr_chinesePostmanCost' AND function_type = 'macro';
----
macro	[edges_sql]
