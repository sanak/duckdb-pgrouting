# name: test/sql/line_graph.test
# description: pgr_lineGraph and pgr_lineGraphFull: EDGE and LINE_GRAPH_FULL rows, order dependence, long answers
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_lineGraph(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
seq	INTEGER
source	BIGINT
target	BIGINT
cost	DOUBLE
reverse_cost	DOUBLE

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_lineGraphFull(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
seq	INTEGER
source	BIGINT
target	BIGINT
cost	DOUBLE
edge	BIGINT

# pgr_lineGraph has one defaulted parameter (directed): two variants; pgr_lineGraphFull one.
query II
SELECT count(*) FILTER (WHERE function_name = 'pgr_lineGraph'), count(*) FILTER (WHERE function_name = 'pgr_lineGraphFull')
FROM duckdb_functions() WHERE tags['ext'] = 'pgrouting';
----
2	1

# Upstream's lineGraph q1: undirected, so every reverse_cost is -1.
query IIIRR
SELECT * FROM pgr_lineGraph('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id IN (2,4,5,8)', false);
----
1	2	4	1	-1
2	2	5	1	-1
3	4	8	1	-1
4	5	8	1	-1

# directed, positional or named.
query I
SELECT count(*) FROM (
  SELECT * FROM pgr_lineGraph('SELECT * FROM edges', false)
  EXCEPT SELECT * FROM pgr_lineGraph('SELECT * FROM edges', directed := false));
----
0

# The same four edges read in the opposite order: each undirected row keeps the orientation met
# first, so the rows (and their order) differ, while the pairs do not.
query IIIRR
SELECT seq, source, target, cost, reverse_cost FROM _pgr_exec((SELECT (SELECT list(e ORDER BY id DESC) FROM (
  SELECT id, source, target, cost, reverse_cost FROM edges WHERE id IN (2,4,5,8)) e) AS edges),
  edges_sql := 'q1 reversed', driver := 'line_graph', directed := false);
----
1	4	2	1	-1
2	5	2	1	-1
3	8	4	1	-1
4	8	5	1	-1

# Upstream's q2 and q3, in the order its INSERTs list the edges (pos). edges_unique has no
# reverse_cost column: every edge is one-way.
statement ok
CREATE TABLE edges_shared (pos INTEGER, id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges_shared VALUES (1, 102, 1, 2, 1, -1), (2, 104, 1, 4, 1, -1), (3, 301, 3, 1, 1, -1),
  (4, 203, 2, 3, 1, 1), (5, 304, 3, 4, 1, 1);

statement ok
CREATE TABLE edges_unique (pos INTEGER, id BIGINT, source BIGINT, target BIGINT, cost DOUBLE);

statement ok
INSERT INTO edges_unique VALUES (1, 102, 1, 2, 1), (2, 104, 1, 4, 1), (3, 301, 3, 1, 1), (4, 203, 2, 3, 1),
  (5, 304, 3, 4, 1), (6, 302, 3, 2, 1), (7, 403, 4, 3, 1);

query IIIRR
SELECT seq, source, target, cost, reverse_cost
FROM pgr_lineGraph('SELECT id, source, target, cost, reverse_cost FROM edges_shared', true);
----
1	102	203	1	-1
2	104	304	1	-1
3	203	203	1	1
4	203	301	1	-1
5	203	304	1	1
6	301	102	1	-1
7	301	104	1	-1
8	304	301	1	-1
9	304	304	1	1

query IIIRR
SELECT seq, source, target, cost, reverse_cost FROM pgr_lineGraph('SELECT id, source, target, cost FROM edges_unique', true);
----
1	102	203	1	-1
2	104	403	1	-1
3	203	301	1	-1
4	203	304	1	-1
5	301	102	1	-1
6	301	104	1	-1
7	302	203	1	1
8	304	403	1	1
9	403	301	1	-1
10	403	302	1	-1

# q3's edges in reverse: the two-way pair 203/302 is now oriented (203, 302) and sorts fourth.
query IIIRR
SELECT seq, source, target, cost, reverse_cost FROM _pgr_exec((SELECT (SELECT list({'id': id, 'source': source,
  'target': target, 'cost': cost} ORDER BY pos DESC) FROM edges_unique) AS edges),
  edges_sql := 'q3 reversed', driver := 'line_graph', directed := true);
----
1	102	203	1	-1
2	104	403	1	-1
3	203	301	1	-1
4	203	302	1	1
5	203	304	1	-1
6	301	102	1	-1
7	301	104	1	-1
8	304	403	1	1
9	403	301	1	-1
10	403	302	1	-1

# A self-loop in the line graph (a two-way edge meeting itself) is kept only when directed.
statement ok
CREATE TABLE loops AS SELECT * FROM (VALUES (1, 1, 2, 1.0, 1.0), (2, 2, 2, 1, 1), (3, 2, 3, 1, -1))
  t(id, source, target, cost, reverse_cost);

query IIIRR
SELECT * FROM pgr_lineGraph('SELECT * FROM loops', false);
----
1	1	2	1	-1
2	1	3	1	-1
3	2	3	1	-1

query IIIRR
SELECT * FROM pgr_lineGraph('SELECT * FROM loops');
----
1	1	1	1	1
2	1	2	1	1
3	1	3	1	-1
4	2	2	1	1
5	2	3	1	-1

# The whole sample graph.
query II
SELECT (SELECT count(*) FROM pgr_lineGraph('SELECT * FROM edges', false)),
       (SELECT count(*) FROM pgr_lineGraph('SELECT * FROM edges'));
----
30	40

# Upstream's lineGraphFull q1 (edges 4, 7, 8, 10), row for row.
query IIIRI
SELECT * FROM pgr_lineGraphFull('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id IN (4, 7, 8, 10)');
----
1	-1	7	1	4
2	6	-1	0	0
3	-2	6	1	-4
4	-3	3	1	-7
5	-4	11	1	8
6	-5	8	1	10
7	7	-2	0	0
8	7	-3	0	0
9	7	-4	0	0
10	7	-5	0	0
11	-6	-2	0	0
12	-6	-3	0	0
13	-6	-4	0	0
14	-6	-5	0	0
15	-7	-2	0	0
16	-7	-3	0	0
17	-7	-4	0	0
18	-7	-5	0	0
19	-8	-2	0	0
20	-8	-3	0	0
21	-8	-4	0	0
22	-8	-5	0	0
23	-9	-6	1	7
24	3	-9	0	0
25	-10	-7	1	-8
26	11	-10	0	0
27	-11	-8	1	-10
28	8	-11	0	0

# The same edges in reverse: other negative ids and another row order, but the same row count,
# zero-cost rows, edge column and positive vertices.
query IITT
SELECT count(*), count(*) FILTER (WHERE cost = 0), list(edge ORDER BY edge) FILTER (WHERE edge <> 0),
       list(DISTINCT source ORDER BY source) FILTER (WHERE source > 0)
FROM _pgr_exec((SELECT (SELECT list(e ORDER BY id DESC) FROM (SELECT id, source, target, cost, reverse_cost
  FROM edges WHERE id IN (4, 7, 8, 10)) e) AS edges), edges_sql := 'q1 reversed', driver := 'line_graph_full');
----
28	20	[-10, -8, -7, -4, 4, 7, 8, 10]	[3, 6, 7, 8, 11]

query I
SELECT count(*) FROM pgr_lineGraphFull('SELECT * FROM edges');
----
95

# No rows, and STRICT.
query IIIII
SELECT (SELECT count(*) FROM pgr_lineGraph('SELECT * FROM edges WHERE id < 0')),
       (SELECT count(*) FROM pgr_lineGraphFull('SELECT * FROM edges WHERE id < 0')),
       (SELECT count(*) FROM pgr_lineGraph(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_lineGraph('SELECT * FROM edges', directed := NULL)),
       (SELECT count(*) FROM pgr_lineGraphFull(NULL::VARCHAR));
----
0	0	0	0	0

# More than one 2048-row output chunk: seq stays continuous.
statement ok
CREATE TABLE path2100 AS SELECT i AS id, i AS source, i + 1 AS target, 1.0 AS cost, 1.0 AS reverse_cost
FROM range(1, 2101) t(i);

query IIIII
SELECT count(*), min(seq), max(seq), count(DISTINCT seq), count(*) FILTER (WHERE abs(source - target) = 1)
FROM pgr_lineGraph('SELECT * FROM path2100', false);
----
2099	1	2099	2099	2099

query IIIIR
SELECT count(*), min(seq), max(seq), count(*) FILTER (WHERE cost = 0), sum(cost)
FROM pgr_lineGraphFull('SELECT * FROM path2100 WHERE id <= 700');
----
4198	1	4198	2798	1400
