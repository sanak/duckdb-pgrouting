# name: test/sql/dominator_tree.test
# description: pgr_lengauerTarjanDominatorTree: idom is the dominator's seq, the pairs are upstream's, long answers
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_lengauerTarjanDominatorTree('SELECT * FROM edges', 5));
----
seq	INTEGER
vertex_id	BIGINT
idom	BIGINT

query T
SELECT parameter_types FROM duckdb_functions()
WHERE function_name = 'pgr_lengauerTarjanDominatorTree' AND tags['ext'] = 'pgrouting';
----
[VARCHAR, BIGINT]

# Root 5, the edges read in id order. idom is not a vertex id: upstream writes the dominator's
# vertex index + 1, which is the seq of the dominator's own row, and 0 for the root and for the
# vertices the root cannot reach. Both follow the order the vertices entered the graph.
query III
SELECT * FROM pgr_lengauerTarjanDominatorTree('SELECT id, source, target, cost, reverse_cost FROM edges', 5) ORDER BY seq;
----
1	5	0
2	6	1
3	10	4
4	15	9
5	7	2
6	11	5
7	1	8
8	3	5
9	16	5
10	8	5
11	12	5
12	17	5
13	9	10
14	2	0
15	4	0
16	13	0
17	14	0

# Read through seq, the answer is each vertex's immediate dominator, and that does not depend on
# the edge order: these are upstream's q1 pairs, from its transcript (made from another order).
query II
WITH t AS MATERIALIZED (SELECT * FROM pgr_lengauerTarjanDominatorTree('SELECT * FROM edges', 5))
SELECT t.vertex_id, coalesce(d.vertex_id, 0) FROM t LEFT JOIN t d ON t.idom = d.seq ORDER BY 1;
----
1	3
2	0
3	7
4	0
5	0
6	5
7	6
8	7
9	8
10	15
11	7
12	7
13	0
14	0
15	16
16	7
17	7

# The same pairs when the edges arrive in reverse.
query I
WITH t AS MATERIALIZED (SELECT seq, id AS vertex_id, value AS idom FROM _pgr_exec((SELECT (SELECT list(e ORDER BY id DESC)
  FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges), edges_sql := 'reversed',
  driver := 'lengauer_tarjan_dominator_tree', root := 5))
SELECT list(concat(t.vertex_id, '>', coalesce(d.vertex_id, 0)) ORDER BY t.vertex_id) FROM t LEFT JOIN t d ON t.idom = d.seq;
----
[1>3, 2>0, 3>7, 4>0, 5>0, 6>5, 7>6, 8>7, 9>8, 10>15, 11>7, 12>7, 13>0, 14>0, 15>16, 16>7, 17>7]

# Upstream's q2: from root 13 only 14 is reached.
query II
WITH t AS MATERIALIZED (SELECT * FROM pgr_lengauerTarjanDominatorTree('SELECT * FROM edges', 13))
SELECT t.vertex_id, d.vertex_id FROM t JOIN t d ON t.idom = d.seq;
----
14	13

# A two-way triangle from vertex 1.
query III
SELECT * FROM pgr_lengauerTarjanDominatorTree('SELECT * FROM (VALUES (1, 1, 2, 1.0, 1.0), (2, 2, 3, 2, 2),
  (3, 3, 1, 3, 3)) t(id, source, target, cost, reverse_cost)', 1) ORDER BY seq;
----
1	1	0
2	2	1
3	3	1

# A root that is not in the graph, no rows, and STRICT.
query IIII
SELECT (SELECT count(*) FROM pgr_lengauerTarjanDominatorTree('SELECT * FROM edges', 99)),
       (SELECT count(*) FROM pgr_lengauerTarjanDominatorTree('SELECT * FROM edges WHERE id < 0', 5)),
       (SELECT count(*) FROM pgr_lengauerTarjanDominatorTree(NULL::VARCHAR, 5)),
       (SELECT count(*) FROM pgr_lengauerTarjanDominatorTree('SELECT * FROM edges', NULL::BIGINT));
----
0	0	0	0

# More than one 2048-row output chunk: along a one-way path each vertex's dominator is the one
# before it, whose row comes just before its own.
statement ok
CREATE TABLE dpath2100 AS SELECT i AS id, i AS source, i + 1 AS target, 1.0 AS cost, -1.0 AS reverse_cost
FROM range(1, 2101) t(i);

query III
SELECT count(*), max(seq), count(*) FILTER (WHERE idom = seq - 1)
FROM pgr_lengauerTarjanDominatorTree('SELECT * FROM dpath2100', 1);
----
2101	2101	2101
