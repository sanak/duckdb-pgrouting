# name: test/sql/coloring_exec.test
# description: _pgr_exec with the coloring drivers: ID_VALUE rows, colorings that depend on the edge order
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

statement ok
CREATE TABLE ex AS SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges;

statement ok
CREATE MACRO q() AS 'SELECT id, source, target, cost, reverse_cost FROM edges';

# Small graphs, each one list of edges in id order: upstream's pgTAP edge cases.
statement ok
CREATE TABLE g (name VARCHAR, id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO g VALUES
  ('edge', 7, 3, 7, 1, 1),
  ('self-loop', 2, 6, 6, -1, 1),
  ('two self-loops', 1, 2, 2, -1, 1), ('two self-loops', 2, 1, 1, 1, -1),
  ('path', 1, 1, 2, 1, 1), ('path', 2, 2, 3, 1, 1), ('path', 3, 3, 4, 1, 1),
  ('triangle', 1, 3, 6, 20, 15), ('triangle', 2, 3, 8, 10, -10), ('triangle', 3, 6, 8, -1, 12),
  ('cycle', 8, 7, 11, 1, 1), ('cycle', 10, 7, 8, 1, 1), ('cycle', 11, 11, 12, 1, -1), ('cycle', 12, 8, 12, 1, -1),
  ('K4', 1, 1, 2, 1, 1), ('K4', 2, 2, 3, 1, -1), ('K4', 3, 3, 4, -1, 1), ('K4', 4, 4, 1, 1, 1),
  ('K4', 5, 1, 3, 1, -1), ('K4', 6, 2, 4, -1, 1);

statement ok
CREATE TABLE graphs AS SELECT name, list({'id': id, 'source': source, 'target': target, 'cost': cost,
  'reverse_cost': reverse_cost} ORDER BY id) AS edges FROM g GROUP BY name;

# Upstream's bipartite q1: two sides, 0 and 1.
query II
SELECT id, value FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(), driver := 'bipartite') ORDER BY id;
----
1	0
2	0
3	1
4	1
5	0
6	1
7	0
8	1
9	0
10	0
11	1
12	0
13	0
14	1
15	1
16	0
17	1

# Upstream's sequentialVertexColoring q1; the driver returns the vertices by id.
query III
SELECT seq, id, value FROM _pgr_exec((SELECT edges FROM ex), edges_sql := q(), driver := 'sequential_vertex_coloring')
ORDER BY seq;
----
1	1	1
2	2	1
3	3	2
