# name: test/sql/dijkstra.test
# description: dijkstra, the five pgr_dijkstra signatures
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5

# A long chain, so that both the materialized input and the result cross STANDARD_VECTOR_SIZE.
# path_seq is a counter carried across output chunks, so it must keep agreeing with seq past the
# first chunk. cost is DECIMAL here: the whole list child vector is cast to DOUBLE in one go, and
# that cast has to cover every chunk of the input as well.
statement ok
CREATE TABLE chain AS
SELECT i AS id, i AS source, i + 1 AS target,
       1.0::DECIMAL(10,2) AS cost, 1.0::DECIMAL(10,2) AS reverse_cost
FROM range(1, 6001) t(i);

query IIIR
SELECT count(*), max(seq), max(path_seq), max(agg_cost)
FROM dijkstra('SELECT id, source, target, cost, reverse_cost FROM chain', 1, 6001);
----
6001	6001	6001	6000

query I
SELECT count(*) FROM dijkstra('SELECT id, source, target, cost, reverse_cost FROM chain', 1, 6001)
WHERE seq <> path_seq;
----
0

# one to many (upstream q3)
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 6, ARRAY[10, 17]);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5
7	1	6	17	6	4	1	0
8	2	6	17	7	8	1	1
9	3	6	17	11	9	1	2
10	4	6	17	16	15	1	3
11	5	6	17	17	-1	0	4

# many to one (upstream q4). Note the driver reverses the graph for this signature
# (normal = false): the search is actually rooted at 17 in the reversed graph, and the resulting
# paths are then reversed back so they read as if built from 6 or 1 towards 17.
#
# From 17, node 12 is reached at distance 2 in the reversed graph, and it has two equal-cost
# predecessors there: node 11 (reversed edge 11) and node 8 (reversed edge 12), both at cost 2.
# Upstream's docqueries/dijkstra/dijkstra.result (generated on a different Boost release) resolves
# this predecessor tie towards node 11; the Boost 1.89 dijkstra_shortest_paths this extension
# vendors via vcpkg resolves it towards node 8 instead. Because normal = false folds both
# departures (starts 6 and 1) into the single combinations entry {17: {1, 6}}
# (cpp_common/combinations.cpp), and pgrouting::algorithms::dijkstra allocates one shared
# predecessors/distances array per departure (dijkstra.hpp's dijkstra_1_to_many), the tie at node
# 12 is resolved once for the whole search tree: both q4 paths necessarily move together, which is
# why every row from node 12 onward differs in both of them. Calling _pgr_shortestpath_exec
# directly with the same request, bypassing bind_replace entirely, reproduces the same route, so
# the tie-break happens inside pgRouting's own unmodified dijkstra_shortest_paths call, not in this
# extension's argument wiring. The rows below are this extension's actually observed (and
# hand-verified valid, equal-cost) output rather than the upstream transcription.
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[6, 1], 17);
----
1	1	1	17	1	6	1	0
2	2	1	17	3	7	1	1
3	3	1	17	7	10	1	2
4	4	1	17	8	12	1	3
5	5	1	17	12	13	1	4
6	6	1	17	17	-1	0	5
7	1	6	17	6	4	1	0
8	2	6	17	7	10	1	1
9	3	6	17	8	12	1	2
10	4	6	17	12	13	1	3
11	5	6	17	17	-1	0	4

# Tie-insensitive companion for q4: start_vid, end_vid, the row count and the total cost of each
# path are exactly what upstream guarantees and are unaffected by which of the two equal-cost
# routes above gets picked, so this survives a future Boost/vcpkg bump independently of the
# exact-row block above. If this block ever fails on its own (the exact-row block still passing),
# that is a real regression, not a tie moving.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[6, 1], 17)
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
1	17	6	5
6	17	5	4

# many to many, undirected (upstream q5)
#
# The 6-to-17 path (rows 14-18) hits an equal-cost predecessor tie structurally identical to the
# many-to-one block above, just reached by an undirected search rooted at 6 instead of a reversed
# directed one rooted at 17: node 7 has a unique predecessor from 6 (node 6 itself, via edge 4),
# but node 12, at distance 3 from 6, has two equal-cost predecessors, node 11 (edge 11) and node 8
# (edge 12), both at cost 3. The 1-to-17 path (rows 6-11) never reaches node 12 at all (its route
# goes through node 16 instead) and matches upstream exactly; it is a separate per-source run
# (pgrouting::algorithms::dijkstra allocates one predecessors/distances array per departure), so it
# cannot be affected by a tie in the 6-rooted run regardless of which way that tie resolves.
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  ARRAY[6, 1], ARRAY[10, 17], directed => false);
----
1	1	1	10	1	6	1	0
2	2	1	10	3	7	1	1
3	3	1	10	7	4	1	2
4	4	1	10	6	2	1	3
5	5	1	10	10	-1	0	4
6	1	1	17	1	6	1	0
7	2	1	17	3	7	1	1
8	3	1	17	7	8	1	2
9	4	1	17	11	9	1	3
10	5	1	17	16	15	1	4
11	6	1	17	17	-1	0	5
12	1	6	10	6	2	1	0
13	2	6	10	10	-1	0	1
14	1	6	17	6	4	1	0
15	2	6	17	7	10	1	1
16	3	6	17	8	12	1	2
17	4	6	17	12	13	1	3
18	5	6	17	17	-1	0	4

# Tie-insensitive companion for q5, same rationale as q4's.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  ARRAY[6, 1], ARRAY[10, 17], directed => false)
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
1	10	5	4
1	17	6	5
6	10	2	1
6	17	5	4

# combinations (upstream q8)
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT * FROM (VALUES (6, 10), (6, 7), (12, 10)) AS combinations (source, target)');
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1
3	1	6	10	6	4	1	0
4	2	6	10	7	8	1	1
5	3	6	10	11	9	1	2
6	4	6	10	16	16	1	3
7	5	6	10	15	3	1	4
8	6	6	10	10	-1	0	5
9	1	12	10	12	13	1	0
10	2	12	10	17	15	1	1
11	3	12	10	16	16	1	2
12	4	12	10	15	3	1	3
13	5	12	10	10	-1	0	4

# positional directed, as PostgreSQL allows (upstream q2)
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10, true);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5

# combinations, positional directed (upstream q52). The combinations table there is (5,6), (5,10),
# (6,5), (6,15), (6,14); (6,14) has no path (14 is only reachable through 13, in a separate
# component) and so contributes no rows, matching upstream.
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT * FROM (VALUES (5,6), (5,10), (6,5), (6,15), (6,14)) AS combinations (source, target)',
  false);
----
1	1	5	6	5	1	1	0
2	2	5	6	6	-1	0	1
3	1	5	10	5	1	1	0
4	2	5	10	6	2	1	1
5	3	5	10	10	-1	0	2
6	1	6	5	6	1	1	0
7	2	6	5	5	-1	0	1
8	1	6	15	6	2	1	0
9	2	6	15	10	3	1	1
10	3	6	15	15	-1	0	2

# one to many, positional directed (upstream q94)
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 6, ARRAY[10, 7], false);
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1
3	1	6	10	6	2	1	0
4	2	6	10	10	-1	0	1

# many to one, positional directed (upstream q95)
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[6, 12], 7, false);
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1
3	1	12	7	12	12	1	0
4	2	12	7	8	10	1	1
5	3	12	7	7	-1	0	2

# many to many, positional directed (upstream q96).
#
# The (12, 7) combination hits another instance of the same class of equal-cost predecessor tie as
# the many-to-one and many-to-many-undirected blocks above: from 12, node 7 is reached at distance
# 2 via two equal-cost routes, through node 11 (edge 11, then edge 8) or through node 8 (edge 12,
# then edge 10). Notably, the very same (12, 7) pair resolves towards the node-8 route (matching
# upstream) in q95's block above, where 7 is the only destination for departure 12; here, where
# departure 12 also has 10 as a destination in the same combinations entry (both pgrouting's own
# code, cpp_common/combinations.cpp and dijkstra.hpp's dijkstra_1_to_many, so the two destinations
# share one predecessors/distances array), the extra destination changes the traversal enough to
# flip this particular tie towards node 11 instead. This is this extension's actually observed (and
# hand-verified valid, equal-cost) output for that one pair, not the upstream transcription; every
# other row here, including the rest of this same query, matches upstream exactly.
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[6, 12], ARRAY[10, 7], false);
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1
3	1	6	10	6	2	1	0
4	2	6	10	10	-1	0	1
5	1	12	7	12	11	1	0
6	2	12	7	11	8	1	1
7	3	12	7	7	-1	0	2
8	1	12	10	12	11	1	0
9	2	12	10	11	5	1	1
10	3	12	10	10	-1	0	2

# Tie-insensitive companion for q96.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[6, 12], ARRAY[10, 7], false)
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
6	7	2	1
6	10	2	1
12	7	3	2
12	10	3	2

# The combinations fetcher only reads `source` and `target`, so pgRouting allows edges_sql and
# combinations_sql to be textually identical (every edge's own endpoints become one combination);
# InputRegistry keys registrations by (sql, kind) rather than by sql alone specifically so this
# does not collide with the edges registration under the same text. Every one of the 18 per-source
# sub-paths below was independently cross-checked against the already-verified one-to-one
# signature called once per (source, target) pair, so none of them can be hiding an undetected tie.
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT id, source, target, cost, reverse_cost FROM edges');
