# name: test/sql/dijkstra.test
# description: dijkstra, the five pgr_dijkstra signatures
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 6, 10);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5

# A long chain, so that both the materialized input and the result cross STANDARD_VECTOR_SIZE.
# path_seq is a counter carried across output chunks, so it must keep agreeing with seq past the
# first chunk. cost is DECIMAL here: the whole list child vector is cast to DOUBLE in one go, and
# that cast has to cover every chunk of the input as well.
statement ok
CREATE TABLE chain AS
SELECT i AS id, i AS source, i + 1 AS target,
       1.0::DECIMAL(10,2) AS cost, 1.0::DECIMAL(10,2) AS reverse_cost
FROM range(1, 6001) t(i);

query IIIR
SELECT count(*), max(seq), max(path_seq), max(agg_cost)
FROM dijkstra('SELECT id, source, target, cost, reverse_cost FROM chain', 1, 6001);
----
6001	6001	6001	6000

query I
SELECT count(*) FROM dijkstra('SELECT id, source, target, cost, reverse_cost FROM chain', 1, 6001)
WHERE seq <> path_seq;
----
0

# one to many (upstream q3)
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 6, ARRAY[10, 17]);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5
7	1	6	17	6	4	1	0
8	2	6	17	7	8	1	1
9	3	6	17	11	9	1	2
10	4	6	17	16	15	1	3
11	5	6	17	17	-1	0	4

# ------------------------------------------------------------------------------------------------
# Equal-cost ties, affecting several blocks below
#
# The queries below that carry a "tie-insensitive companion" each compute at least one path
# through a small equal-cost region of this graph. Every divergence from upstream's transcribed
# docqueries/dijkstra/dijkstra.result output in this file has the same shape: identical
# start_vid/end_vid, identical row count, identical total cost (agg_cost) - only a different
# equal-cost intermediate route. Two independent things decide which of the tied routes comes out.
#
# The first is the Boost release. This extension links boost-graph:arm64-osx@1.89.0 (vcpkg);
# upstream's fixture was almost certainly generated against a different Boost release, and Boost's
# dijkstra_shortest_paths has changed its default priority-queue implementation across releases,
# which is documented to change only tie-breaking among equal-weight edges. Each case was verified
# by calling _pgr_shortestpath_exec directly, bypassing bind_replace entirely, which reproduces the
# same route: the tie-break happens inside pgRouting's own unmodified dijkstra_shortest_paths call,
# not in this extension's argument wiring. That is what the amended rows below record, and it
# changes only when the Boost dependency moves.
#
# The second is the order in which the edges reach the graph. Boost breaks an equal-cost
# predecessor tie by adjacency-list insertion order, and pgRouting's insert_edges inserts in fetch
# order, so the order this extension materializes the user's edges query in propagates straight
# through. DuckDB's list() does not preserve scan order once the scan runs on several threads, and
# adding ORDER BY to the user's own SQL does not change that, so on a large enough edges query the
# same query on the same data can return different equal-cost routes on different runs. Every
# answer is still cost-optimal, and PostgreSQL's own unordered scans give pgr_dijkstra the same
# property. This graph is far too small for it: its 18 rows sit in one row group and scan
# single-threaded, so the exact rows below are stable.
#
#   q4 (both paths; the search is rooted at 17 in the reversed graph, normal = false): node 12,
#     distance 2 from 17, has two equal-cost predecessors; upstream picks node 11 (edge 11), this
#     build picks node 8 (edge 12). Because normal = false folds both departures (6 and 1) into
#     the single combinations entry {17: {1, 6}} (cpp_common/combinations.cpp), and
#     pgrouting::algorithms::dijkstra allocates one shared predecessors/distances array per
#     departure (dijkstra.hpp's dijkstra_1_to_many), this one tie is resolved once for the whole
#     search tree, so both q4 paths necessarily move together. Total cost 5 (path to 1) / 4 (path
#     to 6) either way.
#   q5 (the 6-to-17 path only; the 1-to-17 path is a separate per-departure run, sharing no
#     predecessors/distances array with the 6-to-17 one, and is unaffected): node 12, distance 3
#     from 6, has the same two equal-cost predecessors as q4; upstream picks node 11, this build
#     picks node 8. Total cost 4 either way.
#   q96 (the (12, 7) pair only): node 7, distance 2 from departure 12, has two equal-cost
#     predecessors; upstream picks node 8 (edge 12, then edge 10), this build picks node 11 (edge
#     11, then edge 8). Total cost 2 either way. The very same (12, 7) pair matches upstream when
#     computed alone, with 7 as departure 12's only destination (q95, above), and only flips once
#     departure 12 also has destination 10 in the same combinations entry (q96) - direct evidence
#     that pgRouting decides the route once per departure's shared search tree, not once per
#     (start, end) pair. That is upstream's own algorithm structure, not this extension's wiring.
#   q6 / q7 (the (10, 7) pair): node 7, distance 2 from departure 10, has two equal-cost
#     predecessors; upstream picks node 11 (edge 8), this build picks node 6 (edge 4). Total cost 2
#     either way.
#   q6 / q7 (the (15, 7) pair): node 11, distance 2 from departure 15, has two equal-cost
#     predecessors; upstream picks node 16 (edge 9), this build picks node 10 (edge 5); both then
#     continue identically via edge 8 to node 7. Total cost 3 either way.
# ------------------------------------------------------------------------------------------------

# many to one (upstream q4). Note the driver reverses the graph for this signature (normal =
# false): the search is rooted at 17 in the reversed graph, and the resulting paths are reversed
# back so they read as if built from 6 or 1 towards 17. The rows below diverge from upstream at
# node 12 onward in both paths; see the tie-break summary above for why.
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[6, 1], 17);
----
1	1	1	17	1	6	1	0
2	2	1	17	3	7	1	1
3	3	1	17	7	10	1	2
4	4	1	17	8	12	1	3
5	5	1	17	12	13	1	4
6	6	1	17	17	-1	0	5
7	1	6	17	6	4	1	0
8	2	6	17	7	10	1	1
9	3	6	17	8	12	1	2
10	4	6	17	12	13	1	3
11	5	6	17	17	-1	0	4

# Tie-insensitive companion for q4: start_vid, end_vid, the row count and the total cost of each
# path are exactly what upstream guarantees and are unaffected by which of the two equal-cost
# routes above gets picked, so this survives a future Boost/vcpkg bump independently of the
# exact-row block above. If this block ever fails on its own (the exact-row block still passing),
# that is a real regression, not a tie moving.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[6, 1], 17)
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
1	17	6	5
6	17	5	4

# many to many, undirected (upstream q5). The 6-to-17 path (rows 14-18) diverges from upstream at
# node 12 onward, the same tie described in the summary above, reached this time by an undirected
# search rooted at 6. The 1-to-17 path (rows 6-11) never reaches node 12 (its route goes through
# node 16 instead) and matches upstream exactly.
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  ARRAY[6, 1], ARRAY[10, 17], directed => false);
----
1	1	1	10	1	6	1	0
2	2	1	10	3	7	1	1
3	3	1	10	7	4	1	2
4	4	1	10	6	2	1	3
5	5	1	10	10	-1	0	4
6	1	1	17	1	6	1	0
7	2	1	17	3	7	1	1
8	3	1	17	7	8	1	2
9	4	1	17	11	9	1	3
10	5	1	17	16	15	1	4
11	6	1	17	17	-1	0	5
12	1	6	10	6	2	1	0
13	2	6	10	10	-1	0	1
14	1	6	17	6	4	1	0
15	2	6	17	7	10	1	1
16	3	6	17	8	12	1	2
17	4	6	17	12	13	1	3
18	5	6	17	17	-1	0	4

# Tie-insensitive companion for q5, same rationale as q4's.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  ARRAY[6, 1], ARRAY[10, 17], directed => false)
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
1	10	5	4
1	17	6	5
6	10	2	1
6	17	5	4

