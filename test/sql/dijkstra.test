# many to many (upstream q6). The start array is deliberately duplicated and unsorted
# (ARRAY[7,10,15,10,10,15]) to exercise get_pgset's uniquing; q7 below passes the clean,
# deduplicated array directly, and the two must agree cell for cell regardless of how any tie
# resolves (see the equivalence check after q7). The (10, 7) and (15, 7) pairs diverge from
# upstream - see the tie-break summary above; the other four pairs match upstream exactly.
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  ARRAY[7, 10, 15, 10, 10, 15], ARRAY[10, 7, 10, 15]);
