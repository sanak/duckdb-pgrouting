# Tie-insensitive companion for q6, covering all six pairs: this is the "genuinely
# upstream-verified many-to-many expectation" that the exact-row block above can no longer supply
# on its own for the (10, 7) and (15, 7) pairs, but still can for every pair here.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  ARRAY[7, 10, 15, 10, 10, 15], ARRAY[10, 7, 10, 15])
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
7	10	5	4
7	15	4	3
10	7	3	2
10	15	4	3
15	7	4	3
15	10	2	1

