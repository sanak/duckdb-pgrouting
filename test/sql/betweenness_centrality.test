# name: test/sql/betweenness_centrality.test
# description: pgr_betweennessCentrality: variants, upstream's values directed and undirected, errors, STRICT
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

query II
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name = 'pgr_betweennessCentrality' AND tags['ext'] = 'pgrouting' GROUP BY ALL;
----
pgr_betweennessCentrality	2

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_betweennessCentrality(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
vid	BIGINT
centrality	DOUBLE

# Upstream's q1, and its pgTAP values undirected; the id column is optional.
query IR
SELECT vid, round(centrality, 6) FROM pgr_betweennessCentrality(
  'SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 5') ORDER BY vid;
----
5	0
6	0.5
7	0
10	0.25
15	0

query IR
SELECT vid, round(centrality, 6) FROM pgr_betweennessCentrality(
  'SELECT source, target, cost, reverse_cost FROM edges WHERE id < 5', directed := false) ORDER BY vid;
----
5	0
6	0.833333
7	0
10	0.5
15	0

query IR
SELECT vid, round(centrality, 6) FROM pgr_betweennessCentrality(
  'SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 3', false) ORDER BY vid;
----
5	0
6	1
10	0

statement error
SELECT * FROM pgr_betweennessCentrality('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 0');
----
No edges found

query III
SELECT (SELECT count(*) FROM pgr_betweennessCentrality(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_betweennessCentrality('SELECT * FROM edges', NULL::BOOLEAN)),
       (SELECT count(*) FROM pgr_betweennessCentrality('SELECT * FROM edges', directed => NULL));
----
0	0	0
