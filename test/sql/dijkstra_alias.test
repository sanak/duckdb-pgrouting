# name: test/sql/dijkstra_alias.test
# description: a user column named t does not collide with the materialized-edges subquery alias
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES (1, 1, 2, 1, 1), (2, 2, 3, 1, 1);

# Before the fix, bind_replace wrapped the user's SQL as `(SELECT list(t) FROM (<sql>) t)`. A user
# column named `t` then resolved `list(t)` to that column instead of the whole row, turning `edges`
# into a LIST(BIGINT) instead of LIST(STRUCT) and failing with an internal-looking error. The alias
# is now `_pgr_row`, so a column named `t` is just an ordinary (here, unused) column.
query I
SELECT count(*) FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost, id AS t FROM edges', 1, 3);
----
3
