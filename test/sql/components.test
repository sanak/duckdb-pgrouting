# name: test/sql/components.test
# description: pgr_articulationPoints, pgr_bridges, pgr_biconnectedComponents, pgr_strongComponents, pgr_makeConnected
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

# One upstream signature each, with no defaulted parameter: one variant each.
query II
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name IN ('pgr_articulationPoints', 'pgr_biconnectedComponents', 'pgr_bridges', 'pgr_makeConnected',
                        'pgr_strongComponents')
  AND tags['ext'] = 'pgrouting' GROUP BY ALL ORDER BY 1;
----
pgr_articulationPoints	1
pgr_biconnectedComponents	1
pgr_bridges	1
pgr_makeConnected	1
pgr_strongComponents	1

# Upstream's columns, every one BIGINT.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_articulationPoints(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
node	BIGINT

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_bridges(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
edge	BIGINT

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_biconnectedComponents(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
seq	BIGINT
component	BIGINT
edge	BIGINT

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_strongComponents(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
seq	BIGINT
component	BIGINT
node	BIGINT

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_makeConnected(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
seq	BIGINT
start_vid	BIGINT
end_vid	BIGINT

