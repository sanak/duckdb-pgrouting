# Which vertices makeConnected joins depends on the order the edges are read in (upstream's
# transcript, read in another order, joins 5 and 2); what does not is that the added edges join the
# graph into one component.
query III
SELECT * FROM pgr_makeConnected('SELECT id, source, target, cost, reverse_cost FROM edges');
----
1	9	2
2	4	13

query I
SELECT count(DISTINCT component) FROM pgr_connectedComponents(
  $$SELECT id, source, target, cost, reverse_cost FROM edges
    UNION ALL
    SELECT 100 + seq, start_vid, end_vid, 1, 1
    FROM pgr_makeConnected('SELECT id, source, target, cost, reverse_cost FROM edges')$$);
----
1

# An edge whose cost and reverse_cost differ is two parallel edges in the undirected graph, as
# upstream builds it: never a bridge, listed twice by pgr_biconnectedComponents.
query T
SELECT string_agg(edge::VARCHAR, ' ' ORDER BY edge) FROM pgr_bridges(
  'SELECT * FROM (VALUES (1, 1, 2, 1.0, 1.0), (2, 2, 3, 1.0, 2.0), (3, 3, 4, 1.0, 1.0)) AS t(id, source, target, cost, reverse_cost)');
----
1 3

query T
SELECT string_agg(component || ':' || edge, ' ' ORDER BY seq) FROM pgr_biconnectedComponents(
  'SELECT * FROM (VALUES (1, 1, 2, 1.0, 1.0), (2, 2, 3, 1.0, 2.0), (3, 3, 4, 1.0, 1.0)) AS t(id, source, target, cost, reverse_cost)');
----
1:1 2:2 2:2 2:3

# A graph of self-loops only has no biconnected component (upstream would crash on it).
query I
SELECT count(*) FROM pgr_biconnectedComponents('SELECT 1 AS id, 1 AS source, 1 AS target, 1.0 AS cost');
----
0

statement error
SELECT * FROM pgr_bridges('SELECT source, target, cost FROM edges');
----
Column 'id' not Found

# More than one 2048-row output chunk.
statement ok
CREATE TABLE long_path AS SELECT i AS id, i AS source, i + 1 AS target, 1.0 AS cost, 1.0 AS reverse_cost
FROM range(1, 3000) t(i);

statement ok
CREATE TABLE many_pairs AS SELECT i + 1 AS id, 2 * i + 1 AS source, 2 * i + 2 AS target, 1.0 AS cost,
  1.0 AS reverse_cost FROM range(3000) t(i);

query III
SELECT (SELECT count(*) FROM pgr_articulationPoints('SELECT * FROM long_path')),
       (SELECT count(*) FROM pgr_bridges('SELECT * FROM long_path')),
       (SELECT count(*) FROM pgr_strongComponents('SELECT * FROM long_path'));
----
2998	2999	3000

query IIIII
SELECT count(*), min(seq), max(seq), count(DISTINCT seq), count(*) FILTER (WHERE end_vid <> start_vid + 1)
FROM pgr_makeConnected('SELECT * FROM many_pairs');
----
2999	1	2999	2999	0

# STRICT: a NULL argument gives no rows.
query IIIII
SELECT (SELECT count(*) FROM pgr_articulationPoints(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_bridges(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_biconnectedComponents(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_strongComponents(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_makeConnected(NULL::VARCHAR));
----
0	0	0	0	0
