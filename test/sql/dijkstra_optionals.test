# name: test/sql/dijkstra_optionals.test
# description: defaulted parameters: one variant per positional prefix, named, NULL
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

# A spec row with k defaulted parameters registers k + 1 variants. pgr_dijkstra has one
# (directed) and five signatures, so ten.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'pgr_dijkstra';
----
10

# Every variant accepts every defaulted parameter by name, including the one that also takes it
# positionally.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name = 'pgr_dijkstra' AND NOT list_contains(parameters, 'directed');
----
0

# Positional and named directed agree, both ways round.
query I
SELECT count(*) FROM (
  (SELECT * FROM pgr_dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, false)
   EXCEPT
   SELECT * FROM pgr_dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, directed := false))
  UNION ALL
  (SELECT * FROM pgr_dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, directed := false)
   EXCEPT
   SELECT * FROM pgr_dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, false)));
----
0

# Without reverse_cost every edge is one-way; edge 6 runs 1 -> 3, so 3 -> 1 exists only in the
# undirected graph: node 3 via edge 6, then node 1 closing the path. The flag is observable.
query I
SELECT count(*) FROM pgr_dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, false);
----
2

query I
SELECT count(*) FROM pgr_dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, true);
----
0

# Two signatures with (directed, cap) register 3 variants each, two with (directed, cap, global)
# register 4 each.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'pgr_dijkstraNear';
----
14

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'pgr_dijkstraNearCost';
----
14

# cap passed positionally (p = 2) and by name agree. Upstream's own q2 of dijkstraNear.pg mixes
# the two (positional directed, named cap) and returns 5 rows.
query I
SELECT count(*) FROM (
  SELECT * FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges', [10, 11, 1], 6, true, 2)
  EXCEPT
  SELECT * FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges', [10, 11, 1], 6, true, cap := 2));
----
0

query I
SELECT count(*) FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges', [10, 11, 1], 6, true, 2);
----
5

# global passed positionally (p = 3) and by name agree.
query I
SELECT count(*) FROM (
  SELECT * FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges', [15, 16], [10, 11, 1], false, 1, false)
  EXCEPT
  SELECT * FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges', [15, 16], [10, 11, 1],
                             directed := false, global := false));
----
0

# STRICT applies to every defaulted parameter, positional or named.
query I
SELECT count(*) FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges', 6, [10, 11, 1], cap := NULL);
----
0

query I
SELECT count(*) FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges', 6, [10, 11, 1], true, NULL);
----
0

query I
SELECT count(*) FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges', [15, 16], [10, 11, 1], global := NULL);
----
0

# The combinations form's positional directed (p = 1: VARCHAR, VARCHAR, BOOLEAN) binds without
# ambiguity against the (edges_sql, combinations_sql) overload and agrees with the named form.
query I
SELECT count(*) FROM (
  SELECT * FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges',
                             'SELECT unnest([10, 11, 1]) AS source, 6 AS target', false)
  EXCEPT
  SELECT * FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges',
                             'SELECT unnest([10, 11, 1]) AS source, 6 AS target', directed := false));
----
0

# Row count of the positional-directed combinations call above, measured against the release
# build.
query I
SELECT count(*) FROM pgr_dijkstraNear('SELECT id, source, target, cost, reverse_cost FROM edges',
                             'SELECT unnest([10, 11, 1]) AS source, 6 AS target', false);
----
2
