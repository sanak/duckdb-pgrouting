# name: test/sql/dijkstra_optionals.test
# description: defaulted parameters: one variant per positional prefix, named, NULL
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

# A spec row with k defaulted parameters registers k + 1 variants. pgr_dijkstra has one
# (directed) and five signatures, so ten.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'dijkstra';
----
10

# Every variant accepts every defaulted parameter by name, including the one that also takes it
# positionally.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name = 'dijkstra' AND NOT list_contains(parameters, 'directed');
----
0

# Positional and named directed agree, both ways round.
query I
SELECT count(*) FROM (
  SELECT * FROM dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, false)
  EXCEPT
  SELECT * FROM dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, directed := false));
----
0

# Without reverse_cost every edge is one-way; edge 6 runs 1 -> 3, so 3 -> 1 exists only in the
# undirected graph: node 3 via edge 6, then node 1 closing the path. The flag is observable.
query I
SELECT count(*) FROM dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, false);
----
2

query I
SELECT count(*) FROM dijkstra('SELECT id, source, target, cost FROM edges', 3, 1, true);
----
0
