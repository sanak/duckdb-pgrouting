# name: test/sql/withpoints_cost.test
# description: withPointsCost and withPointsCostMatrix: shape, agreement with withPoints, STRICT
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

statement ok
CREATE TABLE pois (pid BIGINT, edge_id BIGINT, side VARCHAR, fraction DOUBLE);

statement ok
INSERT INTO pois VALUES (1,1,'l',0.4),(2,15,'r',0.4),(3,12,'l',0.6),(4,6,'r',0.3),(5,5,'l',0.8),(6,4,'b',0.7);

statement ok
CREATE MACRO e() AS 'SELECT id, source, target, cost, reverse_cost FROM edges';

statement ok
CREATE MACRO p() AS 'SELECT pid, edge_id, fraction, side FROM pois';

# One defaulted parameter (directed): 2 variants per signature.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'withPointsCost' AND tags['ext'] = 'pgrouting';
----
20

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'withPointsCostMatrix' AND tags['ext'] = 'pgrouting';
----
4

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM withPointsCost(e(), p(), -1, 10));
----
start_vid	BIGINT
end_vid	BIGINT
agg_cost	DOUBLE

# Upstream's q1 (docqueries withPointsCost).
query IIR
SELECT start_vid, end_vid, round(agg_cost, 6) FROM withPointsCost(e(), p(), -1, 10);
----
-1	10	6.4

# Every shape agrees with withPoints' closing rows, both ways round, for a derived and an explicit
# driving side. Many-to-one runs with normal = false in both.
query I
SELECT count(*) FROM (
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPoints(e(), p(), [5, -1], [-2, -3, -6, 10, 11]) WHERE edge = -1
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), p(), [5, -1], [-2, -3, -6, 10, 11]))
  UNION ALL
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), p(), [5, -1], [-2, -3, -6, 10, 11])
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPoints(e(), p(), [5, -1], [-2, -3, -6, 10, 11]) WHERE edge = -1));
----
0

query I
SELECT count(*) FROM (
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPoints(e(), p(), [5, -1], [-2, -3, -6, 10, 11], 'l') WHERE edge = -1
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), p(), [5, -1], [-2, -3, -6, 10, 11], 'l'))
  UNION ALL
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), p(), [5, -1], [-2, -3, -6, 10, 11], 'l')
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPoints(e(), p(), [5, -1], [-2, -3, -6, 10, 11], 'l') WHERE edge = -1));
----
0

query I
SELECT count(*) FROM (
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPoints(e(), p(), [-1, 6], -3) WHERE edge = -1
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), p(), [-1, 6], -3))
  UNION ALL
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), p(), [-1, 6], -3)
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPoints(e(), p(), [-1, 6], -3) WHERE edge = -1));
----
0

query I
SELECT count(*) FROM (
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPoints(e(), p(), 'SELECT * FROM (VALUES (-1, 10), (6, -3)) AS c(source, target)', 'r') WHERE edge = -1
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), p(), 'SELECT * FROM (VALUES (-1, 10), (6, -3)) AS c(source, target)', 'r'))
  UNION ALL
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), p(), 'SELECT * FROM (VALUES (-1, 10), (6, -3)) AS c(source, target)', 'r')
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPoints(e(), p(), 'SELECT * FROM (VALUES (-1, 10), (6, -3)) AS c(source, target)', 'r') WHERE edge = -1));
----
0

# CostMatrix is Cost over every ordered pair of distinct ids; upstream's q1 has 12 rows.
query I
SELECT count(*) FROM (
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCostMatrix(e(), 'SELECT pid, edge_id, fraction FROM pois', [-1, 10, 11, -6], directed := false)
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), 'SELECT pid, edge_id, fraction FROM pois', [-1, 10, 11, -6], [-1, 10, 11, -6], directed := false))
  UNION ALL
  (SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCost(e(), 'SELECT pid, edge_id, fraction FROM pois', [-1, 10, 11, -6], [-1, 10, 11, -6], directed := false)
   EXCEPT SELECT start_vid, end_vid, round(agg_cost, 9) FROM withPointsCostMatrix(e(), 'SELECT pid, edge_id, fraction FROM pois', [-1, 10, 11, -6], directed := false)));
----
0

query I
SELECT count(*) FROM withPointsCostMatrix(e(), 'SELECT pid, edge_id, fraction FROM pois', [-1, 10, 11, -6], directed := false);
----
12

# Overload resolution, as in withpoints.test: VARCHAR binds the CHAR variant, BOOLEAN the
# positional directed.
statement error
SELECT * FROM withPointsCost(e(), p(), -1, 10, 'x');
----
Invalid value of 'driving side'

statement error
SELECT * FROM withPointsCost(e(), p(), 'SELECT -1 AS source, 10 AS target', 'x');
----
Invalid value of 'driving side'

statement error
SELECT * FROM withPointsCostMatrix(e(), p(), [-1, 10], 'x');
----
Invalid value of 'driving side'

statement ok
SELECT * FROM withPointsCost(e(), p(), -1, 10, false);

statement ok
SELECT * FROM withPointsCost(e(), p(), 'SELECT -1 AS source, 10 AS target', false);

statement ok
SELECT * FROM withPointsCostMatrix(e(), p(), [-1, 10], false);

# STRICT.
query I
SELECT count(*) FROM withPointsCost(e(), p(), -1, 10, NULL::VARCHAR);
----
0

query I
SELECT count(*) FROM withPointsCostMatrix(e(), p(), [-1, 10], directed := NULL);
----
0
