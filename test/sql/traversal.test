# name: test/sql/traversal.test
# description: pgr_breadthFirstSearch, pgr_depthFirstSearch: variants, checks, STRICT, long output
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/edges.csv');

statement ok
CREATE MACRO e() AS 'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id';

statement ok
CREATE MACRO no_edges() AS 'SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 0';

# Two defaulted parameters (directed, max_depth): 3 variants per signature.
query II
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name IN ('pgr_breadthFirstSearch', 'pgr_depthFirstSearch') AND tags['ext'] = 'pgrouting'
GROUP BY ALL ORDER BY 1;
----
pgr_breadthFirstSearch	6
pgr_depthFirstSearch	6

# Upstream's q1: breadth-first depths are hop counts, the same in every valid answer.
query II
SELECT node, depth FROM pgr_breadthFirstSearch(e(), 6) ORDER BY node;
----
1	3
3	2
5	1
6	0
7	1
8	2
9	3
10	5
11	2
12	3
15	4
16	3
17	4

query I
SELECT count(*) FROM pgr_breadthFirstSearch(e(), 6, true)
UNION ALL SELECT count(*) FROM pgr_breadthFirstSearch(e(), 6, true, 100)
UNION ALL SELECT count(*) FROM pgr_breadthFirstSearch(e(), [6], directed := true, max_depth := 100)
UNION ALL SELECT count(*) FROM pgr_depthFirstSearch(e(), 6)
UNION ALL SELECT count(DISTINCT node) FROM pgr_depthFirstSearch(e(), [6], true, 9223372036854775807);
----
13
13
13
13
13

# Upstream's q2: undirected, max_depth 2, roots 12 and 6.
query II
SELECT start_vid, count(*) FROM pgr_breadthFirstSearch(e(), [12, 6], directed := false, max_depth := 2)
GROUP BY 1 ORDER BY 1;
----
6	8
12	8

query T
SELECT max(depth) <= 2 FROM pgr_depthFirstSearch(e(), [12, 6], directed := false, max_depth := 2::INTEGER);
----
true

# max_depth 0 keeps the roots.
query I
SELECT count(*) FROM pgr_breadthFirstSearch(e(), [6, 12], max_depth := 0)
UNION ALL SELECT count(*) FROM pgr_depthFirstSearch(e(), 6, true, 0);
----
2
1

# The check has an empty hint upstream, so the message stands alone.
statement error
SELECT * FROM pgr_breadthFirstSearch(e(), 6, max_depth := -1);
----
Invalid Input Error: Negative value found on 'max_depth'

statement error
SELECT * FROM pgr_depthFirstSearch(no_edges(), [6], true, -1);
----
Invalid Input Error: Negative value found on 'max_depth'

# BFS reads roots as a set, DFS as a non-empty array.
query I
SELECT count(*) FROM pgr_breadthFirstSearch(e(), []::BIGINT[]);
----
0

statement error
SELECT * FROM pgr_depthFirstSearch(e(), []::BIGINT[]);
----
No elements found

# An absent root adds nothing beyond, at most, its own depth-0 row.
query II
SELECT count(*) FILTER (WHERE start_vid = 6), count(*) FILTER (WHERE start_vid = 999 AND node <> 999)
FROM pgr_breadthFirstSearch(e(), [6, 999]);
----
13	0

# No edges. BFS returns nothing, DFS each root's depth-0 row.
query I
SELECT count(*) FROM pgr_breadthFirstSearch(no_edges(), 6);
----
0

query IIIIIIRR
SELECT * FROM pgr_depthFirstSearch(no_edges(), 6);
----
1	0	6	6	6	-1	0	0

# STRICT.
query I
SELECT count(*) FROM pgr_breadthFirstSearch(e(), NULL::BIGINT)
UNION ALL SELECT count(*) FROM pgr_breadthFirstSearch(e(), 6, directed := NULL)
UNION ALL SELECT count(*) FROM pgr_depthFirstSearch(e(), 6, max_depth := NULL)
UNION ALL SELECT count(*) FROM pgr_depthFirstSearch(e(), NULL::BIGINT[], true, -1);
----
0
0
0
0

# More rows than one DuckDB vector through a public function: a 5001-vertex chain from 1.
statement ok
CREATE TABLE long_chain AS
SELECT i AS id, i AS source, i + 1 AS target, 1.0 AS cost FROM range(1, 5001) t(i);

query IIIII
SELECT count(*), count(DISTINCT seq), max(seq), max(depth), count(*) FILTER (WHERE depth <> node - 1)
FROM pgr_breadthFirstSearch('SELECT * FROM long_chain', 1);
----
5001	5001	5001	5000	0
