# name: test/sql/spatial_smoke.test
# description: duckdb-spatial installs and loads next to this extension
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later
#
# pgr_extractVertices and pgr_findCloseEdges call duckdb-spatial's ST_* functions at run time;
# the extension never builds or links spatial. spatial is not autoloadable in DuckDB v1.5, and
# sqllogictest's `require spatial` only loads statically linked extensions, so every test that
# needs spatial is tagged `spatial` and installs and loads it explicitly, from the network. Runs
# that cannot (the Wasm unittest, and any DuckDB version without published extension binaries)
# pass test/configs/skip_spatial.json, which skips every file with this tag.

tags spatial

require pgrouting

statement ok
INSTALL spatial;

statement ok
LOAD spatial;

query T
SELECT ST_AsText(ST_StartPoint(CAST('LINESTRING(2 0,2 1)' AS GEOMETRY)));
----
POINT (2 0)
