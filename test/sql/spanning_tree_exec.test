# name: test/sql/spanning_tree_exec.test
# description: _pgr_exec with the kruskal, prim, BFS and DFS drivers: suffixes, checks, empty inputs
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/edges.csv');

# DuckDB passes a table macro's parameters to the wrapped table function's named arguments as
# unresolved names, not as constants, so _pgr_exec(..., mst_suffix := m_suffix, ...) cannot be
# behind a macro here (see driving_distance_exec.test); every query below inlines the _pgr_exec
# call with literal values instead. The edge lists do not depend on those literals, so they are
# factored into a plain table instead of being repeated verbatim.
statement ok
CREATE TABLE tree_common AS
SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
       (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 14) e)
         AS edges_lt14,
       (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 0) e)
         AS edges_empty;

# pgr_kruskal's call (kruskal.sql): roots [0], no suffix, max_depth and distance -1, which no check
# reads without a suffix. The forest of the 18-edge sample has 17 vertices in 3 components: 14
# edges, depth 0 and agg_cost 0 throughout.
query IRIR
SELECT count(*), sum(cost), max(depth), max(agg_cost) FROM _pgr_exec(
  (SELECT edges, [0]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'kruskal', mst_suffix := '', max_depth := -1, distance := -1.0);
----
14	14	0	0

# pgr_prim's upstream q1, on the edges with id < 14: 11 edges.
query I
SELECT count(*) FROM _pgr_exec(
  (SELECT edges_lt14 AS edges, [0]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 14',
  driver := 'prim', mst_suffix := '', max_depth := -1, distance := -1.0);
----
11

# kruskalBFS q1 (root 6): the tree spans 6's component, whatever tree it is.
query I
SELECT node FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'kruskal', mst_suffix := 'BFS', max_depth := 9223372036854775807, distance := -1.0)
ORDER BY node;
----
1
3
5
6
7
8
9
10
11
12
15
16
17

# kruskalBFS q2: max_depth 3 from 9 and 6. Each root opens its tree with a depth-0 row.
query III
SELECT start_vid, pred, node FROM _pgr_exec(
  (SELECT edges, [9, 6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'kruskal', mst_suffix := 'BFS', max_depth := 3, distance := -1.0)
WHERE depth = 0 ORDER BY 1;
----
6	6	6
9	9	9

query T
SELECT max(depth) <= 3 FROM _pgr_exec(
  (SELECT edges, [9, 6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'kruskal', mst_suffix := 'BFS', max_depth := 3, distance := -1.0);
----
true

# primDD q1: within 3.5 of 6 along the tree.
query TT
SELECT count(*) > 1, max(agg_cost) <= 3.5 FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'prim', mst_suffix := 'DD', max_depth := -1, distance := 3.5);
----
true	true

# primDFS: the tree spans 6's component.
query II
SELECT count(*), count(DISTINCT node) FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'prim', mst_suffix := 'DFS', max_depth := 9223372036854775807, distance := -1.0);
----
13	13

# The C entries' checks (src/spanningTree/kruskal.c, prim.c): the bound the suffix uses, verbatim.
statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'kruskal', mst_suffix := 'DD', max_depth := -1, distance := -0.5);
----
Invalid Input Error: Negative value found on 'distance'
HINT: Must be positive

statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'prim', mst_suffix := 'BFS', max_depth := -1, distance := -1.0);
----
Invalid Input Error: Negative value found on 'max_depth'
HINT: Must be positive

statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'kruskal', mst_suffix := 'DFS', max_depth := -3, distance := -1.0);
----
Negative value found on 'max_depth'

# An unknown suffix reaches the driver, which names its family.
statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'kruskal', mst_suffix := 'XYZ', max_depth := 1, distance := 1.0);
----
Unknown Kruskal function

statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'prim', mst_suffix := 'XYZ', max_depth := 1, distance := 1.0);
----
Unknown Prim function

# Review focus 1: these drivers read roots as a non-empty array.
statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, []::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'kruskal', mst_suffix := 'BFS', max_depth := 3, distance := -1.0);
----
No elements found

# Review focus 3: no edges gives each root its depth-0 row (details::get_no_edge_graph_result), and
# kruskal's own root 0 none.
query IIIIIIRR
SELECT * FROM _pgr_exec(
  (SELECT edges_empty AS edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 0',
  driver := 'kruskal', mst_suffix := 'DFS', max_depth := 5, distance := -1.0);
----
1	0	6	6	6	-1	0	0

query I
SELECT count(*) FROM _pgr_exec(
  (SELECT edges_empty AS edges, [0]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 0',
  driver := 'prim', mst_suffix := '', max_depth := -1, distance := -1.0);
----
0

# breadthFirstSearch q1: from 6, directed. Depths are hop counts, the same for every valid answer.
query II
SELECT node, depth FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'breadth_first_search', directed := true, max_depth := 9223372036854775807)
ORDER BY node;
----
1	3
3	2
5	1
6	0
7	1
8	2
9	3
10	5
11	2
12	3
15	4
16	3
17	4

# breadthFirstSearch q2: undirected, max_depth 2, roots 12 and 6.
query II
SELECT start_vid, count(*) FROM _pgr_exec(
  (SELECT edges, [12, 6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'breadth_first_search', directed := false, max_depth := 2)
GROUP BY 1 ORDER BY 1;
----
6	8
12	8

# depthFirstSearch q1: every vertex of 6's component once.
query II
SELECT count(*), count(DISTINCT node) FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'depth_first_search', directed := true, max_depth := 9223372036854775807);
----
13	13

query T
SELECT max(depth) <= 2 FROM _pgr_exec(
  (SELECT edges, [12, 6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'depth_first_search', directed := false, max_depth := 2);
----
true

# The traversal C entries' check has an empty hint, so the message stands alone.
statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'breadth_first_search', directed := true, max_depth := -1);
----
Invalid Input Error: Negative value found on 'max_depth'

statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, [6]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'depth_first_search', directed := true, max_depth := -1);
----
Invalid Input Error: Negative value found on 'max_depth'

# Review focus 1: BFS reads roots as a set, DFS as a non-empty array.
query I
SELECT count(*) FROM _pgr_exec(
  (SELECT edges, []::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'breadth_first_search', directed := true, max_depth := 3);
----
0

statement error
SELECT * FROM _pgr_exec(
  (SELECT edges, []::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'depth_first_search', directed := true, max_depth := 3);
----
No elements found

# Review focus 2: an absent root adds nothing beyond, at most, its own depth-0 row.
query II
SELECT count(*) FILTER (WHERE start_vid = 6), count(*) FILTER (WHERE start_vid = 999 AND node <> 999)
FROM _pgr_exec(
  (SELECT edges, [6, 999]::BIGINT[] AS roots FROM tree_common),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'breadth_first_search', directed := true, max_depth := 9223372036854775807);
----
13	0

# STRICT: nothing is checked when an argument is NULL.
query I
SELECT count(*) FROM _pgr_exec((SELECT NULL AS edges), edges_sql := '', driver := 'depth_first_search',
  max_depth := -1, null_input := true);
----
0
