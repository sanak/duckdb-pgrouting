# name: test/sql/withpoints_via.test
# description: pgr_withPointsVia: variants, driving side, details, STRICT
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/edges.csv');

statement ok
CREATE TABLE pointsofinterest AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/pointsofinterest.csv');

statement ok
CREATE MACRO e() AS 'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id';

statement ok
CREATE MACRO p() AS 'SELECT pid, edge_id, side, fraction FROM pointsofinterest';

# Two signatures, each with four defaulted parameters (directed, strict, U_turn_on_edge, details).
query II
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name = 'pgr_withPointsVia' AND tags['ext'] = 'pgrouting' GROUP BY ALL;
----
pgr_withPointsVia	10

# Upstream's q0 and q1.
query IIIRR
SELECT path_id, start_vid, end_vid, round(agg_cost, 6), round(route_agg_cost, 6)
FROM pgr_withPointsVia(e(), p(), [-6, 15, -5]) WHERE edge < 0 ORDER BY seq;
----
1	-6	15	3.3	3.3
2	15	-5	1.8	5.1

query IIIRR
SELECT path_id, start_vid, end_vid, round(agg_cost, 6), round(route_agg_cost, 6)
FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15]) WHERE edge < 0 ORDER BY seq;
----
1	-1	7	2.4	2.4
2	7	-3	1.6	4
3	-3	16	2.4	6.4
4	16	15	1	7.4

# Every variant of both signatures: 12 rows.
query I
SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], true)
UNION ALL SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], true, false, true, false)
UNION ALL SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], 'r')
UNION ALL SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], 'r', true, false, true, false)
UNION ALL SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], 'R', details := false);
----
12
12
12
12
12

# Without a side argument the side follows directed: the same rows as 'r' directed and 'b'
# undirected.
query I
SELECT count(*) FROM (
  (SELECT * FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15])
   EXCEPT SELECT * FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], 'r'))
  UNION ALL
  (SELECT * FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], false)
   EXCEPT SELECT * FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], 'b', false)));
----
0

# details adds the points passed on the way, never removes a row.
query T
SELECT (SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15], details := true))
     > (SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7, -3, 16, 15]));
----
true

statement error
SELECT * FROM pgr_withPointsVia(e(), p(), [-1, 7], 'x');
----
Invalid Input Error: Invalid value of 'driving side'
HINT: Valid value are 'r', 'l', 'b'

# An unreachable leg: 4 cannot be reached from 7. Without strict, the other legs come back and
# the missing leg's path_id (2) is skipped; strict := true gives no rows.
query IIIRR
SELECT path_id, start_vid, end_vid, round(agg_cost, 6), round(route_agg_cost, 6)
FROM pgr_withPointsVia(e(), p(), [5, 7, 4, 2]) WHERE edge < 0 ORDER BY seq;
----
1	5	7	2	2
3	4	2	1	3

# One vertex is no leg at all; no vertex at all is upstream's error.
query I
SELECT count(*) FROM pgr_withPointsVia(e(), p(), [5, 7, 4, 2], strict := true)
UNION ALL SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1]);
----
0
0

statement error
SELECT * FROM pgr_withPointsVia(e(), p(), []::BIGINT[]);
----
No elements found

query I
SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7], NULL::VARCHAR)
UNION ALL SELECT count(*) FROM pgr_withPointsVia(e(), p(), [-1, 7], details := NULL)
UNION ALL SELECT count(*) FROM pgr_withPointsVia(e(), NULL::VARCHAR, [-1, 7], 'x');
----
0
0
0
