# name: test/sql/dijkstra_inputs.test
# description: pgr_dijkstra input contract: NULLs, SQL validation, column types, visibility
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES (1, 1, 2, 1, 1), (2, 2, 3, 1, 1);

# pgRouting functions are STRICT: any NULL argument yields an empty result, not an error.
query I
SELECT count(*) FROM pgr_dijkstra(NULL, 1, 3);
----
0

query I
SELECT count(*) FROM pgr_dijkstra('SELECT id, source, target, cost FROM edges', NULL, 3);
----
0

# The columns are still there when the result is empty.
query T
SELECT list(column_name ORDER BY column_name)
FROM (DESCRIBE SELECT * FROM pgr_dijkstra(NULL, 1, 3));
----
[agg_cost, cost, edge, end_vid, node, path_seq, seq, start_vid]

# A NULL `directed` is STRICT whichever way it is written. PostgreSQL applies STRICT to the
# function, not to the call syntax, so upstream returns an empty result for `directed => NULL` just
# as it does for a positional NULL. Both forms are pinned here because DuckDB keeps a named
# argument out of the positional inputs, which makes them two separate code paths on this side.
query I
SELECT count(*) FROM pgr_dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 1, 3, directed := NULL);
----
0

query I
SELECT count(*) FROM pgr_dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 1, 3, NULL);
----
0

# A non-NULL `directed` still arrives, both ways round: only a NULL one is swallowed. Dropping
# reverse_cost makes the edges one-way, so 3 -> 1 exists in the undirected graph only, and the
# flag's value is therefore observable in the row count.
query I
SELECT count(*) FROM pgr_dijkstra(
  'SELECT id, source, target, cost FROM edges', 3, 1, directed := false);
----
3

query I
SELECT count(*) FROM pgr_dijkstra(
  'SELECT id, source, target, cost FROM edges', 3, 1, false);
----
3

query I
SELECT count(*) FROM pgr_dijkstra(
  'SELECT id, source, target, cost FROM edges', 3, 1, true);
----
0

# The input must be exactly one SELECT statement. The "Invalid Input Error: " prefix pins the
# exception class as InvalidInputException, not ParserException: a bare-text block would pass for
# either, and the whole point of this check is that the caller sees one consistent class.
statement error
SELECT * FROM pgr_dijkstra('DELETE FROM edges', 1, 3);
----
Invalid Input Error: Expected a single SELECT statement

statement error
SELECT * FROM pgr_dijkstra('SELECT 1; SELECT 2', 1, 3);
----
Invalid Input Error: Expected a single SELECT statement

# Every integer class pgRouting accepts for ANY-INTEGER works.
query I
SELECT count(*) FROM pgr_dijkstra(
  'SELECT id::INTEGER AS id, source::SMALLINT AS source, target::UINTEGER AS target,
          cost::FLOAT AS cost, reverse_cost FROM edges', 1, 3);
----
3

# Column lookup is case-insensitive: the struct keeps the user's spelling.
query I
SELECT count(*) FROM pgr_dijkstra(
  'SELECT id AS ID, source AS Source, target AS TARGET, cost AS Cost FROM edges', 1, 3);
----
3

# UBIGINT does not round-trip through int64, so it is not ANY-INTEGER.
statement error
SELECT * FROM pgr_dijkstra(
  'SELECT id, source::UBIGINT AS source, target, cost FROM edges', 1, 3);
----
Invalid Input Error: Unexpected Column 'source' type. Expected ANY-INTEGER

# Inputs are evaluated in the caller's transaction: TEMP tables are visible.
statement ok
CREATE TEMP TABLE tmp_edges AS SELECT * FROM edges;

query I
SELECT count(*) FROM pgr_dijkstra('SELECT id, source, target, cost FROM tmp_edges', 1, 3);
----
3

# ... and so are uncommitted rows.
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO edges VALUES (3, 3, 4, 1, 1);

query I
SELECT count(*) FROM pgr_dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 1, 4);
----
4

statement ok
ROLLBACK;

# A prepared statement re-binds per EXECUTE, so bind_replace always sees concrete values.
statement ok
PREPARE q AS SELECT count(*) FROM pgr_dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', $1, 3);

query I
EXECUTE q(1);
----
3

query I
EXECUTE q(2);
----
2

# A wrong-typed 'starts' argument reaches _pgr_shortestpath_exec directly (bypassing bind_replace,
# which always passes LIST(BIGINT)) as a user-input error, not an internal one: DuckDB invalidates
# the whole database instance on InternalException, so this path must never raise that class for a
# condition any caller can trigger from SQL.
statement error
SELECT * FROM _pgr_shortestpath_exec(
  (SELECT NULL AS edges, NULL AS combinations, 'bad'::VARCHAR AS starts,
          [3]::BIGINT[] AS ends),
  edges_sql := '', combinations_sql := '', directed := true, only_cost := false, normal := true,
  n_goals := 0, global := false, which := 0, driving_side := ' ', details := true,
  null_input := false, result_kind := 'path');
----
Invalid Input Error: _pgr_shortestpath_exec: column 'starts' must be LIST(BIGINT), got VARCHAR

# Same class of check, same reason, for 'edges'/'combinations': a non-LIST cell reaches
# ListVector::GetChildMutable, and a LIST-but-not-STRUCT cell clears that check and dies one line
# later in StructVector::GetEntries. Both are D_ASSERT failures in this build, i.e. InternalException.
statement error
SELECT * FROM _pgr_shortestpath_exec(
  (SELECT 'x'::VARCHAR AS edges, NULL AS combinations, []::BIGINT[] AS starts,
          []::BIGINT[] AS ends),
  edges_sql := '', combinations_sql := '', directed := true, only_cost := false, normal := true,
  n_goals := 0, global := false, which := 0, driving_side := ' ', details := true,
  null_input := false, result_kind := 'path');
----
Invalid Input Error: _pgr_shortestpath_exec: column 'edges' must be LIST(STRUCT), got VARCHAR

statement error
SELECT * FROM _pgr_shortestpath_exec(
  (SELECT [1, 2]::BIGINT[] AS edges, NULL AS combinations, []::BIGINT[] AS starts,
          []::BIGINT[] AS ends),
  edges_sql := '', combinations_sql := '', directed := true, only_cost := false, normal := true,
  n_goals := 0, global := false, which := 0, driving_side := ' ', details := true,
  null_input := false, result_kind := 'path');
----
Invalid Input Error: _pgr_shortestpath_exec: column 'edges' must be LIST(STRUCT), got BIGINT[]

# A NULL element inside an otherwise well-typed id list is reachable from the public API, not only
# from a direct call: BigIntValue::Get does not assert on a NULL Value (it still carries the BIGINT
# physical type, only its payload is unset), so without this check it would silently use whatever
# bytes happen to be there as a vertex id instead of raising.
statement error
SELECT * FROM pgr_dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', [1, NULL]::BIGINT[], 3);
----
Invalid Input Error: _pgr_shortestpath_exec: column 'starts' contains a NULL id
