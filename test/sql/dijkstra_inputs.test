# name: test/sql/dijkstra_inputs.test
# description: dijkstra input contract: NULLs, SQL validation, column types, visibility
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES (1, 1, 2, 1, 1), (2, 2, 3, 1, 1);

# pgRouting functions are STRICT: any NULL argument yields an empty result, not an error.
query I
SELECT count(*) FROM dijkstra(NULL, 1, 3);
----
0

query I
SELECT count(*) FROM dijkstra('SELECT id, source, target, cost FROM edges', NULL, 3);
----
0

# The columns are still there when the result is empty.
query T
SELECT list(column_name ORDER BY column_name)
FROM (DESCRIBE SELECT * FROM dijkstra(NULL, 1, 3));
----
[agg_cost, cost, edge, end_vid, node, path_seq, seq, start_vid]

# A NULL passed as the named `directed` parameter is not scanned for STRICT NULL handling: it
# falls back to `directed = true` and the call still returns rows.
query I
SELECT count(*) FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 1, 3, directed := NULL);
----
3

# The input must be exactly one SELECT statement.
statement error
SELECT * FROM dijkstra('DELETE FROM edges', 1, 3);
----
Expected a single SELECT statement

statement error
SELECT * FROM dijkstra('SELECT 1; SELECT 2', 1, 3);
----
Expected a single SELECT statement

# Every integer class pgRouting accepts for ANY-INTEGER works.
query I
SELECT count(*) FROM dijkstra(
  'SELECT id::INTEGER AS id, source::SMALLINT AS source, target::UINTEGER AS target,
          cost::FLOAT AS cost, reverse_cost FROM edges', 1, 3);
----
3

# Column lookup is case-insensitive: the struct keeps the user's spelling.
query I
SELECT count(*) FROM dijkstra(
  'SELECT id AS ID, source AS Source, target AS TARGET, cost AS Cost FROM edges', 1, 3);
----
3

# UBIGINT does not round-trip through int64, so it is not ANY-INTEGER.
statement error
SELECT * FROM dijkstra(
  'SELECT id, source::UBIGINT AS source, target, cost FROM edges', 1, 3);
----
Unexpected Column 'source' type. Expected ANY-INTEGER

# Inputs are evaluated in the caller's transaction: TEMP tables are visible.
statement ok
CREATE TEMP TABLE tmp_edges AS SELECT * FROM edges;

query I
SELECT count(*) FROM dijkstra('SELECT id, source, target, cost FROM tmp_edges', 1, 3);
----
3

# ... and so are uncommitted rows.
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO edges VALUES (3, 3, 4, 1, 1);

query I
SELECT count(*) FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 1, 4);
----
4

statement ok
ROLLBACK;

# A prepared statement re-binds per EXECUTE, so bind_replace always sees concrete values.
statement ok
PREPARE q AS SELECT count(*) FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', $1, 3);

query I
EXECUTE q(1);
----
3

query I
EXECUTE q(2);
----
2

# A wrong-typed 'starts' argument reaches _pgr_shortestpath_exec directly (bypassing bind_replace,
# which always passes LIST(BIGINT)) as a user-input error, not an internal one: DuckDB invalidates
# the whole database instance on InternalException, so this path must never raise that class for a
# condition any caller can trigger from SQL.
statement error
SELECT * FROM _pgr_shortestpath_exec(
  (SELECT NULL::VARCHAR AS edges, NULL::VARCHAR AS combinations, 'bad'::VARCHAR AS starts,
          [3]::BIGINT[] AS ends),
  edges_sql := '', combinations_sql := '', directed := true, only_cost := false, normal := true,
  n_goals := 0, global := false, which := 0, driving_side := ' ', details := true,
  null_input := false, result_kind := 'path');
----
Invalid Input Error: _pgr_shortestpath_exec: column 'starts' must be LIST(BIGINT), got VARCHAR
