# name: test/sql/connected_components.test
# description: pgr_connectedComponents: registration, result, negative costs, empty input, errors, STRICT
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

# One upstream signature with no defaulted parameters: one variant.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name = 'pgr_connectedComponents' AND tags['pgrouting_name'] = 'pgr_connectedComponents';
----
1

# All three result columns are BIGINT, as upstream declares them.
query TTT
SELECT typeof(seq), typeof(component), typeof(node)
FROM pgr_connectedComponents('SELECT id, source, target, cost, reverse_cost FROM edges') LIMIT 1;
----
BIGINT	BIGINT	BIGINT

# Upstream's q1 in shape: 17 vertices in components 1, 2 and 13.
query II
SELECT component, count(*) FROM pgr_connectedComponents(
  'SELECT id, source, target, cost, reverse_cost FROM edges') GROUP BY ALL ORDER BY 1;
----
1	13
2	2
13	2

# An edge with both costs negative is not inserted and neither are its vertices (3 and 4 are
# absent, not singletons); one usable direction connects both ends in the undirected graph.
statement ok
CREATE TABLE neg (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO neg VALUES (1,1,2,1,-1),(2,3,4,-1,-1),(3,5,6,-1,1);

query III
SELECT * FROM pgr_connectedComponents('SELECT id, source, target, cost, reverse_cost FROM neg');
----
1	1	1
2	1	2
3	5	5
4	5	6

# No edges: no rows and no error (upstream reports a notice).
query I
SELECT count(*) FROM pgr_connectedComponents('SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 0');
----
0

# The shared error mapping.
statement error
SELECT * FROM pgr_connectedComponents('SELECT id, source, target FROM edges');
----
Invalid Input Error: Column 'cost' not Found
HINT: SELECT id, source, target FROM edges

# STRICT.
query I
SELECT count(*) FROM pgr_connectedComponents(NULL);
----
0
