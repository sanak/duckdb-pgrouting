# q5: this build reaches the same optimum by a different equal-cost route, so only what upstream
# guarantees is asserted: endpoints, row count and total agg_cost
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM (SELECT * FROM pgr_dagShortestPath(
  'SELECT id, source, target, cost FROM edges',
  ARRAY[5, 15], ARRAY[11, 17]))
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
5	11	4	3
5	17	6	5
15	17	3	2

