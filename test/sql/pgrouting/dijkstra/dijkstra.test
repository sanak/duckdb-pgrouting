# name: test/sql/pgrouting/dijkstra/dijkstra.test
# description: Upstream pgr_dijkstra documentation queries, converted by hand
# group: [pgrouting]

# SPDX-License-Identifier: GPL-2.0-or-later
#
# Queries and expected rows come from pgRouting v4.0.2's own documentation queries for
# pgr_dijkstra (third_party/pgrouting/docqueries/dijkstra/dijkstra.pg and its committed
# dijkstra.result); the only edits are the dropped pgr_ prefix and psql's aligned output rewritten
# as sqllogictest rows. The sample graph and combinations are the ones pgRouting's documentation
# uses; test/data/pgrouting_sample/edges.csv and combinations.csv were transcribed from
# docqueries/src/sampledata.result (source/target) and tools/testers/sampledata.pg (cost,
# reverse_cost, and the combinations rows) since building the fixture upstream's own way requires
# PostGIS and pgr_extractVertices, neither of which this extension depends on.

require routing

statement ok
CREATE TABLE edges AS SELECT * FROM read_csv_auto('test/data/pgrouting_sample/edges.csv');

statement ok
CREATE TABLE combinations AS SELECT * FROM read_csv_auto('test/data/pgrouting_sample/combinations.csv');

# ------------------------------------------------------------------------------------------------
# Boost-version-dependent ties
#
# q4, q5, q6 and q7 below each diverge from upstream's committed dijkstra.result by an equal-cost
# tie-break only: same start_vid/end_vid, same row count, same total cost (agg_cost), only a
# different equal-cost intermediate route. test/sql/dijkstra.test already documents this in detail
# (the vendored Boost 1.89 breaks a tie at node 12 that upstream's fixture, generated against a
# different Boost release, breaks the other way) for the very same pairs reached here:
#   - q4 (both paths, upstream ARRAY[6, 1] -> 17) and q5's 6-to-17 path: the tie at node 12,
#     distance 2/3 from the destination-rooted search.
#   - q6 and q7 (the (10, 7) and (15, 7) pairs; the other four pairs in each match upstream
#     exactly): the ties at node 7 (from departure 10) and node 11 (from departure 15).
# The four blocks below carry this build's own observed rows instead of upstream's, each followed
# by a tie-insensitive companion query (start_vid, end_vid, row count, total agg_cost) whose
# numbers are unaffected by which side of the tie a future Boost/vcpkg bump lands on and are
# identical to upstream's.
# ------------------------------------------------------------------------------------------------

# q2: positional directed
query IIIIIIRR
SELECT * FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  6, 10, true);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5

# q3: one to many
query IIIIIIRR
SELECT * FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  6, ARRAY[10, 17]);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5
7	1	6	17	6	4	1	0
8	2	6	17	7	8	1	1
9	3	6	17	11	9	1	2
10	4	6	17	16	15	1	3
11	5	6	17	17	-1	0	4

# q4: many to one. This build's own observed rows: node 12, distance 2/3 from destination 17 in
# the reversed search, has two equal-cost predecessors; upstream picks node 11 (edge 11), this
# build picks node 8 (edge 12). See test/sql/dijkstra.test's tie-break summary for the full
# analysis (same graph, same pair, same tie).
query IIIIIIRR
SELECT * FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[6, 1], 17);
----
1	1	1	17	1	6	1	0
2	2	1	17	3	7	1	1
3	3	1	17	7	10	1	2
4	4	1	17	8	12	1	3
5	5	1	17	12	13	1	4
6	6	1	17	17	-1	0	5
7	1	6	17	6	4	1	0
8	2	6	17	7	10	1	1
9	3	6	17	8	12	1	2
10	4	6	17	12	13	1	3
11	5	6	17	17	-1	0	4

# Tie-insensitive companion for q4.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[6, 1], 17)
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
1	17	6	5
6	17	5	4

# q5: many to many, undirected. This build's own observed rows: the 6-to-17 path diverges from
# upstream at the same node-12 tie as q4 (reached here via an undirected search rooted at 6); the
# 1-to-17 and 1-to-10 and 6-to-10 paths never reach node 12 and match upstream exactly.
query IIIIIIRR
SELECT * FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[6, 1], ARRAY[10, 17],
  directed => false);
----
1	1	1	10	1	6	1	0
2	2	1	10	3	7	1	1
3	3	1	10	7	4	1	2
4	4	1	10	6	2	1	3
5	5	1	10	10	-1	0	4
6	1	1	17	1	6	1	0
7	2	1	17	3	7	1	1
8	3	1	17	7	8	1	2
9	4	1	17	11	9	1	3
10	5	1	17	16	15	1	4
11	6	1	17	17	-1	0	5
12	1	6	10	6	2	1	0
13	2	6	10	10	-1	0	1
14	1	6	17	6	4	1	0
15	2	6	17	7	10	1	1
16	3	6	17	8	12	1	2
17	4	6	17	12	13	1	3
18	5	6	17	17	-1	0	4

# Tie-insensitive companion for q5.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[6, 1], ARRAY[10, 17],
  directed => false)
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
1	10	5	4
1	17	6	5
6	10	2	1
6	17	5	4

# q51: the combinations table used by q52 below.
query II
SELECT source, target FROM combinations;
----
5	6
5	10
6	5
6	15
6	14

# q52: combinations, positional undirected. (6, 14) has no path (14 is only reachable through 13,
# in a separate component) and so contributes no rows, matching upstream.
query IIIIIIRR
SELECT * FROM Dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT source, target FROM combinations',
  false);
----
1	1	5	6	5	1	1	0
2	2	5	6	6	-1	0	1
3	1	5	10	5	1	1	0
4	2	5	10	6	2	1	1
5	3	5	10	10	-1	0	2
6	1	6	5	6	1	1	0
7	2	6	5	5	-1	0	1
8	1	6	15	6	2	1	0
9	2	6	15	10	3	1	1
10	3	6	15	15	-1	0	2

# q6: many to many. This build's own observed rows: the (10, 7) and (15, 7) pairs each diverge
# from upstream at a node with two equal-cost predecessors (node 7 from departure 10, node 11 from
# departure 15); the other four pairs (7,10), (7,15), (10,15) and (15,10) match upstream exactly.
query IIIIIIRR
SELECT * FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[7, 10, 15, 10, 10, 15], ARRAY[10, 7, 10, 15]);
----
1	1	7	10	7	8	1	0
2	2	7	10	11	9	1	1
3	3	7	10	16	16	1	2
4	4	7	10	15	3	1	3
5	5	7	10	10	-1	0	4
6	1	7	15	7	8	1	0
7	2	7	15	11	9	1	1
8	3	7	15	16	16	1	2
9	4	7	15	15	-1	0	3
10	1	10	7	10	2	1	0
11	2	10	7	6	4	1	1
12	3	10	7	7	-1	0	2
13	1	10	15	10	5	1	0
14	2	10	15	11	9	1	1
15	3	10	15	16	16	1	2
16	4	10	15	15	-1	0	3
17	1	15	7	15	3	1	0
18	2	15	7	10	5	1	1
19	3	15	7	11	8	1	2
20	4	15	7	7	-1	0	3
21	1	15	10	15	3	1	0
22	2	15	10	10	-1	0	1

# Tie-insensitive companion for q6, covering all six pairs.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[7, 10, 15, 10, 10, 15], ARRAY[10, 7, 10, 15])
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
7	10	5	4
7	15	4	3
10	7	3	2
10	15	4	3
15	7	4	3
15	10	2	1

# q7: many to many, the same six pairs as q6 from a clean, deduplicated start array. Same tie
# behavior as q6.
query IIIIIIRR
SELECT * FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[7, 10, 15], ARRAY[7, 10, 15]);
----
1	1	7	10	7	8	1	0
2	2	7	10	11	9	1	1
3	3	7	10	16	16	1	2
4	4	7	10	15	3	1	3
5	5	7	10	10	-1	0	4
6	1	7	15	7	8	1	0
7	2	7	15	11	9	1	1
8	3	7	15	16	16	1	2
9	4	7	15	15	-1	0	3
10	1	10	7	10	2	1	0
11	2	10	7	6	4	1	1
12	3	10	7	7	-1	0	2
13	1	10	15	10	5	1	0
14	2	10	15	11	9	1	1
15	3	10	15	16	16	1	2
16	4	10	15	15	-1	0	3
17	1	15	7	15	3	1	0
18	2	15	7	10	5	1	1
19	3	15	7	11	8	1	2
20	4	15	7	7	-1	0	3
21	1	15	10	15	3	1	0
22	2	15	10	10	-1	0	1

# Tie-insensitive companion for q7, same rationale as q6's.
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[7, 10, 15], ARRAY[7, 10, 15])
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
7	10	5	4
7	15	4	3
10	7	3	2
10	15	4	3
15	7	4	3
15	10	2	1

# q8: combinations passed as SQL text, positional directed.
query IIIIIIRR
SELECT * FROM Dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT * FROM (VALUES (6, 10), (6, 7), (12, 10)) AS combinations (source, target)');
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1
3	1	6	10	6	4	1	0
4	2	6	10	7	8	1	1
5	3	6	10	11	9	1	2
6	4	6	10	16	16	1	3
7	5	6	10	15	3	1	4
8	6	6	10	10	-1	0	5
9	1	12	10	12	13	1	0
10	2	12	10	17	15	1	1
11	3	12	10	16	16	1	2
12	4	12	10	15	3	1	3
13	5	12	10	10	-1	0	4

# q70: one to one, the shortest signature (directed defaults to true, using lowercase pgr_dijkstra
# as upstream does for this and the remaining queries).
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  6, 10
);
----
1	1	6	10	6	4	1	0
2	2	6	10	7	8	1	1
3	3	6	10	11	9	1	2
4	4	6	10	16	16	1	3
5	5	6	10	15	3	1	4
6	6	6	10	10	-1	0	5

# q71
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  6, 7
);
----
1	1	6	7	6	4	1	0
2	2	6	7	7	-1	0	1

