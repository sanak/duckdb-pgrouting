# q4: this build reaches the same optimum by a different equal-cost route, so only what upstream
# guarantees is asserted: endpoints, row count and total agg_cost
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM (SELECT * FROM pgr_Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[6, 1], 17))
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
1	17	6	5
6	17	5	4

# q5: this build reaches the same optimum by a different equal-cost route, so only what upstream
# guarantees is asserted: endpoints, row count and total agg_cost
query IIIR
SELECT start_vid, end_vid, count(*), max(agg_cost)
FROM (SELECT * FROM pgr_Dijkstra(
  'select id, source, target, cost, reverse_cost from edges',
  ARRAY[6, 1], ARRAY[10, 17],
  directed => false))
GROUP BY start_vid, end_vid ORDER BY 1, 2;
----
1	10	5	4
1	17	6	5
6	10	2	1
6	17	5	4

