3	3	12	10	16	16	1	2
4	4	12	10	15	3	1	3
5	5	12	10	10	-1	0	4

# q73
query IIIIIIRR
SELECT * FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  12, 7
);
