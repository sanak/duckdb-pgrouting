# q2: skipped - calls pgr_extractVertices on the edges' geometry, which needs the spatial extension; pgr_degree itself does not, and q9 asserts the same vertices through the sample vertices table

# q3
query II
SELECT * from pgr_degree('SELECT 1 as id, 2 as source, 2 as target');
----
2	2

# q4
query II
SELECT * FROM pgr_degree(
  $$SELECT 1 AS id$$,
  $$SELECT id, in_edges, out_edges
     FROM pgr_extractVertices('SELECT 1 as id, 2 as source, 2 as target')$$);
----
2	2

# q5: skipped - no ORDER BY: upstream's rows come in PostgreSQL's hash order, this build's sorted by node (test/sql/degree.test asserts the same rows)

# q6
query II
SELECT * FROM pgr_degree(
  $$SELECT * FROM edges WHERE id IN (1, 2)$$,
  $$SELECT id, in_edges, out_edges FROM vertices$$);
----
5	1
6	2
10	1

