# q2
query R
SELECT agg_cost FROM  pgr_withPointsVia(
  'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
  'SELECT pid, edge_id, side, fraction FROM pointsOfInterest',
  ARRAY[-1, 7, -3, 16, 15])
WHERE path_id = 3 AND edge < 0;
----
2.4

# q3
query R
SELECT route_agg_cost FROM  pgr_withPointsVia(
  'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
  'SELECT pid, edge_id, side, fraction FROM pointsOfInterest',
  ARRAY[-1, 7, -3, 16, 15])
WHERE path_id = 3 AND edge < 0;
----
6.4

# q4
query II
SELECT row_number() over () as node_seq, node
FROM  pgr_withPointsVia(
  'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
  'SELECT pid, edge_id, side, fraction FROM pointsOfInterest',
  ARRAY[-1, 7, -3, 16, 15])
WHERE edge <> -1 ORDER BY seq;
----
1	-1
2	6
3	7
4	8
5	-3
6	12
7	17
8	16
9	15

# q5
query IR
SELECT path_id, route_agg_cost FROM  pgr_withPointsVia(
  'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
  'SELECT pid, edge_id, side, fraction FROM pointsOfInterest',
  ARRAY[-1, 7, -3, 16, 15])
WHERE edge < 0;
----
1	2.4
2	4
3	6.4
4	7.4

# q6
query IIT
SELECT seq, node,
CASE WHEN edge = -1 THEN 'visits'
ELSE 'passes in front'
END as status
FROM  pgr_withPointsVia(
  'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
  'SELECT pid, edge_id, side, fraction FROM pointsOfInterest',
  ARRAY[-1, 7, -3, 16, 15], details => true)
WHERE agg_cost <> 0 or seq = 1;
----
1	-1	passes in front
2	5	passes in front
3	6	passes in front
4	-6	passes in front
5	7	visits
7	8	passes in front
8	-3	visits
10	12	passes in front
11	17	passes in front
12	16	visits
14	15	passes in front

