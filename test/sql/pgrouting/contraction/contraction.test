require pgrouting

statement ok
CREATE TABLE edges AS
  SELECT * REPLACE (CAST(geom AS GEOMETRY) AS geom)
  FROM read_csv_auto('test/data/sampledata/edges.csv');

statement ok
CREATE TABLE vertices AS
  SELECT id, CAST(in_edges AS BIGINT[]) AS in_edges,
         CAST(out_edges AS BIGINT[]) AS out_edges, x, y
  FROM read_csv_auto('test/data/sampledata/vertices.csv');

statement ok
CREATE TABLE pointsofinterest AS
  SELECT * REPLACE (CAST(geom AS GEOMETRY) AS geom)
  FROM read_csv_auto('test/data/sampledata/pointsofinterest.csv');

statement ok
CREATE TABLE combinations AS
  SELECT * FROM read_csv_auto('test/data/sampledata/combinations.csv');

statement ok
CREATE TABLE restrictions AS
  SELECT id, CAST(path AS BIGINT[]) AS path, CAST(cost AS DOUBLE) AS cost
  FROM read_csv_auto('test/data/sampledata/restrictions.csv');

# q1: shortcut ids, and in an undirected graph their direction, follow the order the edges are
# read in, so only what upstream guarantees is asserted: each vertex's absorbed vertices and each
# shortcut's endpoints, cost and bypassed vertices
query TITIIR
SELECT type, CASE WHEN type = 'v' THEN id ELSE 0 END, CAST(list_sort(contracted_vertices) AS VARCHAR), least(source, target), greatest(source, target), cost
FROM (SELECT * FROM pgr_contraction(
  'SELECT id, source, target, cost, reverse_cost FROM edges', false))
ORDER BY ALL;
----
e	0	[15]	10	16	2
e	0	[17]	12	16	2
e	0	[5, 6]	7	10	2
e	0	[8, 9]	7	12	2
v	4	[2]	-1	-1	-1
v	7	[1, 3]	-1	-1	-1
v	14	[13]	-1	-1	-1

# q2: shortcut ids, and in an undirected graph their direction, follow the order the edges are
# read in, so only what upstream guarantees is asserted: each vertex's absorbed vertices and each
# shortcut's endpoints, cost and bypassed vertices
query TIT
SELECT type, CASE WHEN type = 'v' THEN id ELSE 0 END, CAST(list_sort(contracted_vertices) AS VARCHAR)
FROM (SELECT type, id, contracted_vertices FROM pgr_contraction(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  methods => ARRAY[1]))
ORDER BY ALL;
----
v	4	[2]
v	6	[5]
v	7	[1, 3]
v	8	[9]
v	14	[13]

# q3: shortcut ids, and in an undirected graph their direction, follow the order the edges are
# read in, so only what upstream guarantees is asserted: each vertex's absorbed vertices and each
