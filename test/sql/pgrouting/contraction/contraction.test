query TITIIR
SELECT type, CASE WHEN type = 'v' THEN id ELSE 0 END, CAST(list_sort(contracted_vertices) AS VARCHAR), least(source, target), greatest(source, target), cost
FROM (SELECT * FROM pgr_contraction(
