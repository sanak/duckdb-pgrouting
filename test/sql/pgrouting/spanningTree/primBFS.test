  FROM read_csv_auto('test/data/sampledata/restrictions.csv');

# q1: which minimum spanning forest is built among equal-cost edges depends on the C++ standard
# library's priority-queue order, so only what every such forest guarantees is asserted: each
# root's single depth-0 row, no repeated node, and every other row hanging off its predecessor one
# level up at the predecessor's cost plus its own
query IITI
WITH q AS (SELECT * FROM pgr_primBFS(
  'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
  6))
SELECT start_vid,
       count(*) FILTER (WHERE depth = 0),
       count(*) = count(DISTINCT node),
       count(*) FILTER (WHERE depth > 0 AND NOT EXISTS (
         SELECT 1 FROM q AS p
         WHERE p.start_vid = q.start_vid AND p.node = q.pred AND p.depth = q.depth - 1
           AND abs(p.agg_cost + q.cost - q.agg_cost) < 1e-9))
FROM q
GROUP BY start_vid
ORDER BY start_vid;
----
6	1	true	0

# q2: which minimum spanning forest is built among equal-cost edges depends on the C++ standard
# library's priority-queue order, so only what every such forest guarantees is asserted: each
# root's single depth-0 row, no repeated node, and every other row hanging off its predecessor one
# level up at the predecessor's cost plus its own
query IITI
WITH q AS (SELECT * FROM pgr_primBFS(
  'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
  ARRAY[9, 6], max_depth => 3))
SELECT start_vid,
       count(*) FILTER (WHERE depth = 0),
       count(*) = count(DISTINCT node),
       count(*) FILTER (WHERE depth > 0 AND NOT EXISTS (
         SELECT 1 FROM q AS p
         WHERE p.start_vid = q.start_vid AND p.node = q.pred AND p.depth = q.depth - 1
           AND abs(p.agg_cost + q.cost - q.agg_cost) < 1e-9))
FROM q
GROUP BY start_vid
ORDER BY start_vid;
----
6	1	true	0
9	1	true	0

