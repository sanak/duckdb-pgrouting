# name: test/sql/edge_disjoint_paths.test
# description: pgr_edgeDisjointPaths: KSP rows, the many-to-one column swap, paths per pair in any order, long answers
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

statement ok
CREATE TABLE combinations (source BIGINT, target BIGINT);

statement ok
INSERT INTO combinations VALUES (5, 6), (5, 10), (6, 5), (6, 15), (6, 14);

statement ok
CREATE MACRO sample() AS 'SELECT id, source, target, cost, reverse_cost FROM edges';

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_edgeDisjointPaths(sample(), 11, 12));
----
seq	INTEGER
path_id	INTEGER
path_seq	INTEGER
start_vid	BIGINT
end_vid	BIGINT
node	BIGINT
edge	BIGINT
cost	DOUBLE
agg_cost	DOUBLE

# Upstream's q1 and q2, row for row: path_id runs across the pairs, path_seq restarts after edge -1.
query IIIIIIIRR
SELECT * FROM pgr_edgeDisjointPaths(sample(), 11, 12);
----
1	1	1	11	12	11	8	1	0
2	1	2	11	12	7	10	1	1
3	1	3	11	12	8	12	1	2
4	1	4	11	12	12	-1	0	3
5	2	1	11	12	11	11	1	0
6	2	2	11	12	12	-1	0	1

query IIIIIIIRR
SELECT * FROM pgr_edgeDisjointPaths(sample(), 11, ARRAY[5, 10, 12]);
----
1	1	1	11	5	11	8	1	0
2	1	2	11	5	7	4	1	1
3	1	3	11	5	6	1	1	2
4	1	4	11	5	5	-1	0	3
5	2	1	11	10	11	9	1	0
6	2	2	11	10	16	16	1	1
7	2	3	11	10	15	3	1	2
8	2	4	11	10	10	-1	0	3
9	3	1	11	12	11	8	1	0
10	3	2	11	12	7	10	1	1
11	3	3	11	12	8	12	1	2
12	3	4	11	12	12	-1	0	3
13	4	1	11	12	11	11	1	0
14	4	2	11	12	12	-1	0	1

# Many to one: upstream's wrapper selects end_vid into start_vid and start_vid into end_vid, so the
# sink shows as start_vid while each path still starts at its source (upstream's q3).
query II
SELECT DISTINCT start_vid, end_vid FROM pgr_edgeDisjointPaths(sample(), ARRAY[11, 3, 17], 12) ORDER BY 2;
----
12	3
12	11
12	17

query IIII
SELECT end_vid, count(*) FILTER (WHERE edge = -1), min(node) FILTER (WHERE path_seq = 1),
       max(node) FILTER (WHERE edge = -1)
FROM pgr_edgeDisjointPaths(sample(), ARRAY[11, 3, 17], 12) GROUP BY end_vid ORDER BY 1;
----
3	1	3	12
11	2	11	12
17	1	17	12

# Upstream's q4 (many to many), whose paths depend on the edge order: paths per pair.
query III
SELECT start_vid, end_vid, count(*) FILTER (WHERE edge = -1)
FROM pgr_edgeDisjointPaths(sample(), ARRAY[11, 3, 17], ARRAY[5, 10, 12]) GROUP BY ALL ORDER BY 1, 2;
----
3	5	1
3	10	1
3	12	1
11	5	1
11	10	1
11	12	2
17	5	1
17	10	1
17	12	1

# Upstream's q51 and q6, undirected: a walk against a reverse_cost of -1 reports cost -1. 6 -> 14
# has no path.
query III
SELECT start_vid, end_vid, count(*) FILTER (WHERE edge = -1)
FROM pgr_edgeDisjointPaths(sample(), 'SELECT * FROM combinations WHERE target NOT IN (5, 6)', directed := false)
GROUP BY ALL ORDER BY 1, 2;
----
5	10	1
6	15	2

query III
SELECT start_vid, end_vid, count(*) FILTER (WHERE edge = -1)
FROM pgr_edgeDisjointPaths(sample(), 'SELECT * FROM (VALUES (5, 10), (6, 15), (6, 14)) AS t(source, target)', false)
GROUP BY ALL ORDER BY 1, 2;
----
5	10	1
6	15	2

# directed, positionally or by name, reaches the driver the same way in every signature.
query TTT
SELECT (SELECT list(edge ORDER BY seq) FROM pgr_edgeDisjointPaths(sample(), 11, 12, false)) =
       (SELECT list(edge ORDER BY seq) FROM pgr_edgeDisjointPaths(sample(), 11, 12, directed := false)),
       (SELECT count(*) FROM pgr_edgeDisjointPaths(sample(), ARRAY[11], ARRAY[12], true)) = 6,
       (SELECT count(*) FROM pgr_edgeDisjointPaths(sample(), ARRAY[11], 12, directed := true)) = 6;
----
true	true	true

query I
SELECT count(*) FROM pgr_edgeDisjointPaths(sample(), 11, 12, directed := NULL);
----
0

# A pair whose source is its target is skipped silently.
query II
SELECT DISTINCT start_vid, end_vid FROM pgr_edgeDisjointPaths(sample(), ARRAY[11, 12], ARRAY[11, 12]) ORDER BY 1;
----
11	12
12	11

# Nothing to do: no rows.
query III
SELECT (SELECT count(*) FROM pgr_edgeDisjointPaths('SELECT * FROM edges WHERE id < 0', 11, 12)),
       (SELECT count(*) FROM pgr_edgeDisjointPaths(sample(), 11, 14)),
       (SELECT count(*) FROM pgr_edgeDisjointPaths(sample(), 'SELECT * FROM combinations WHERE source < 0'));
----
0	0	0

statement error
SELECT * FROM pgr_edgeDisjointPaths('SELECT id, source, target FROM edges', 11, 12);
----
Column 'cost' not Found

# Among parallel edges upstream names the one read first for every path: both paths report edge 1.
query T
SELECT list(edge ORDER BY seq) FROM pgr_edgeDisjointPaths(
  'SELECT * FROM (VALUES (1, 1, 2, 1.0, -1.0), (2, 1, 2, 1.0, -1.0)) t(id, source, target, cost, reverse_cost)', 1, 2);
----
[1, -1, 1, -1]

# More than one output chunk: 700 two-edge paths from 0 to 701. seq, path_id and path_seq continue
# across chunks: path k occupies seq 3k-2 .. 3k.
statement ok
CREATE TABLE fan AS
  SELECT i AS id, 0 AS source, i AS target, 1.0 AS cost, -1.0 AS reverse_cost FROM range(1, 701) t(i)
  UNION ALL SELECT 700 + i, i, 701, 1.0, -1.0 FROM range(1, 701) t(i);

query IIIII
SELECT count(*), max(seq), max(path_id),
       count(*) FILTER (WHERE path_id <> (seq + 2) // 3 OR path_seq <> (seq - 1) % 3 + 1),
       count(*) FILTER (WHERE edge = -1 AND (node <> 701 OR agg_cost <> 2))
FROM pgr_edgeDisjointPaths('SELECT * FROM fan', 0, 701);
----
2100	2100	700	0	0
