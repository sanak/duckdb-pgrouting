Internal error: no 'edges' input registered for query: WITH  edges AS (SELECT id, source, target, cost, reverse_cost FROM edges),  points AS (SELECT pid, edge_id, fraction, side FROM pois) SELECT edges.* FROM edges WHERE NOT EXISTS (SELECT edge_id FROM points WHERE id = edge_id)

# The points input is looked up first, under its own kind.
statement error
SELECT * FROM _pgr_shortestpath_exec(
  (SELECT NULL AS edges, NULL AS combinations, [-1]::BIGINT[] AS starts, [10]::BIGINT[] AS ends),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  points_sql := 'SELECT pid, edge_id, fraction, side FROM pois',
  combinations_sql := '', directed := true, only_cost := false, normal := true,
  n_goals := 0, global := true, which := 1, driving_side := 'r', details := true,
  null_input := false, result_kind := 'path');
----
Internal error: no 'points' input registered for query: SELECT pid, edge_id, fraction, side FROM pois

# A points query that matches no rows is registered empty with its bound row shape, like an empty
# edge query: every edge then lands in edges_no_points and the answer is plain Dijkstra's, 6 for
# 5 -> 10 (5 -> 6 -> 7 -> 11 -> 16 -> 15 -> 10; edge 2 only runs 10 -> 6).
query IIR
SELECT start_vid, end_vid, agg_cost FROM _pgr_shortestpath_exec(
  (SELECT NULL AS edges, NULL AS combinations, [5]::BIGINT[] AS starts, [10]::BIGINT[] AS ends,
          (SELECT list(p) FROM (SELECT pid, edge_id, fraction, side FROM pois WHERE false) p)
            AS points,
          (SELECT list(e) FROM (SELECT DISTINCT edges.* FROM edges
                                JOIN (SELECT * FROM pois WHERE false) q ON (id = edge_id)) e)
            AS edges_of_points,
          (SELECT list(e) FROM (SELECT * FROM edges) e) AS edges_no_points),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  points_sql := 'SELECT pid, edge_id, fraction, side FROM pois WHERE false',
  combinations_sql := '', directed := true, only_cost := false, normal := true,
  n_goals := 0, global := true, which := 1, driving_side := 'r', details := true,
  null_input := false, result_kind := 'path')
WHERE edge = -1;
----
5	10	6

# The new columns are shape-checked at bind time like 'edges', for the same reason (see
# dijkstra_inputs.test): a wrong-typed cell must be a user-input error, never an internal one.
statement error
SELECT * FROM _pgr_shortestpath_exec(
  (SELECT NULL AS edges, NULL AS combinations, []::BIGINT[] AS starts, []::BIGINT[] AS ends,
          'x'::VARCHAR AS points),
  edges_sql := '', points_sql := 'SELECT 1', combinations_sql := '', directed := true,
  only_cost := false, normal := true, n_goals := 0, global := true, which := 1,
  driving_side := 'r', details := true, null_input := false, result_kind := 'path');
----
Invalid Input Error: _pgr_shortestpath_exec: column 'points' must be LIST(STRUCT), got VARCHAR
