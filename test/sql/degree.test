# name: test/sql/degree.test
# description: pgr_degree: both forms, their column checks, dryrun, self-loops
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

statement ok
CREATE TABLE vertices AS SELECT id, in_edges, out_edges FROM pgr_extractVertices('SELECT id, source, target FROM edges');

# Two signatures, each with one defaulted parameter (dryrun): four variants.
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'pgr_degree' AND tags['ext'] = 'pgrouting';
----
4

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_degree('SELECT id, source, target FROM edges'));
----
node	BIGINT
degree	BIGINT

# Upstream's q1 (from source and target), and the same count from the vertices' edge lists.
query II
SELECT * FROM pgr_degree('SELECT id, source, target FROM edges');
----
1	1
2	1
3	2
4	1
5	1
6	3
7	4
8	3
9	1
10	3
11	4
12	3
13	1
14	1
15	2
16	3
17	2

query I
SELECT count(*) FROM (
  SELECT * FROM pgr_degree('SELECT id, source, target FROM edges')
  EXCEPT SELECT * FROM pgr_degree('SELECT id FROM edges', 'SELECT id, in_edges, out_edges FROM vertices'));
----
0

# Upstream's q3 and q4: a self-loop counts twice.
query II
SELECT * FROM pgr_degree('SELECT 1 AS id, 2 AS source, 2 AS target');
----
2	2

query II
SELECT * FROM pgr_degree('SELECT 1 AS id',
  'SELECT id, in_edges, out_edges FROM pgr_extractVertices(''SELECT 1 AS id, 2 AS source, 2 AS target'')');
----
2	2

# Upstream's q5 and q6: only the edges given count. Unlike upstream, the rows come sorted by node.
query II
SELECT * FROM pgr_degree('SELECT * FROM edges WHERE id IN (1, 2)');
----
5	1
6	2
10	1

query II
SELECT * FROM pgr_degree('SELECT * FROM edges WHERE id IN (1, 2)', 'SELECT id, in_edges, out_edges FROM vertices');
----
5	1
6	2
10	1

# With only one of the two lists, only that one counts.
query II
SELECT * FROM pgr_degree('SELECT id FROM edges WHERE id IN (1, 2)', 'SELECT id, in_edges FROM vertices');
----
6	1
10	1

query II
SELECT * FROM pgr_degree('SELECT id FROM edges WHERE id IN (1, 2)', 'SELECT id, out_edges FROM vertices');
----
5	1
6	1

# Upstream's column checks, with its messages.
statement error
SELECT * FROM pgr_degree('SELECT id, target FROM edges');
----
column "source" does not exist

statement error
SELECT * FROM pgr_degree('SELECT id, CAST(source AS DOUBLE) AS source, target FROM edges');
----
Expected type of column "source" is ANY-INTEGER

statement error
SELECT * FROM pgr_degree('SELECT id FROM edges', 'SELECT id FROM vertices');
----
column "in_edges" does not exist

statement error
SELECT * FROM pgr_degree('SELECT id FROM edges', 'SELECT id, CAST(in_edges AS DOUBLE[]) AS in_edges FROM vertices');
----
Expected type of column "in_edges" is ANY-INTEGER-ARRAY

statement error
SELECT * FROM pgr_degree('SELECT source FROM edges', 'SELECT id, in_edges, out_edges FROM vertices');
----
column "id" does not exist

# dryrun: no rows, and only whether the columns exist is checked, not their types.
query I
SELECT count(*) FROM pgr_degree('SELECT id, CAST(source AS DOUBLE) AS source, target FROM edges', dryrun := true);
----
0

query I
SELECT count(*) FROM pgr_degree('SELECT id FROM edges', 'SELECT id, in_edges, out_edges FROM vertices', true);
----
0

statement error
SELECT * FROM pgr_degree('SELECT id, target FROM edges', true);
----
column "source" does not exist

# STRICT.
query IIII
SELECT (SELECT count(*) FROM pgr_degree(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_degree('SELECT id, source, target FROM edges', dryrun := NULL)),
       (SELECT count(*) FROM pgr_degree('SELECT id FROM edges', NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_degree('SELECT id FROM edges', 'SELECT id, in_edges FROM vertices', NULL::BOOLEAN));
----
0	0	0	0
