# name: test/sql/driving_distance_exec.test
# description: _pgr_exec with the driving-distance driver: the MST shape, the roots slot, the distance check
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/edges.csv');

# DuckDB passes a table macro's parameters to the wrapped table function's named arguments as
# unresolved names, not as constants, so _pgr_exec(..., distance := dist, ...) cannot be behind a
# macro here; every query below inlines the _pgr_exec call with literal values instead.

# The shape's columns, in the order every public wrapper selects them.
query TTTTTTTT
SELECT typeof(seq), typeof(depth), typeof(start_vid), typeof(pred), typeof(node), typeof(edge),
       typeof(cost), typeof(agg_cost)
FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := true, equicost := false) LIMIT 1;
----
BIGINT	BIGINT	BIGINT	BIGINT	BIGINT	BIGINT	DOUBLE	DOUBLE

# Upstream's q5: from 11 within 3.0, directed. Every vertex once, at its shortest cost.
query IR
SELECT node, agg_cost FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := true, equicost := false) ORDER BY node;
----
1	3
3	2
5	3
6	2
7	1
8	2
9	3
10	3
11	0
12	1
15	2
16	1
17	2

# The root is the first row: depth 0, its own predecessor, edge -1. seq numbers the rows from 1.
query IIIIIIRR
SELECT * FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := true, equicost := false) WHERE node = 11;
----
1	0	11	11	11	-1	0	0

query IIII
SELECT count(*), min(seq), max(seq), count(DISTINCT seq) FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := true, equicost := false);
----
13	1	13	13

# On unit costs the depth of a vertex is its cost.
query I
SELECT count(*) FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := true, equicost := false) WHERE depth <> agg_cost;
----
0

# Upstream's q6: equicost gives each vertex to its nearest root only.
query II
SELECT start_vid, count(*) FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11, 16]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := true, equicost := true) GROUP BY 1 ORDER BY 1;
----
11	9
16	4

query II
SELECT count(*), count(DISTINCT node) FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11, 16]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := true, equicost := true);
----
13	13

# Without equicost each root keeps its whole tree: 11's is q5's.
query I
SELECT count(*) FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11, 16]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := true, equicost := false) WHERE start_vid = 11;
----
13

# Upstream's q10: undirected.
query II
SELECT start_vid, count(*) FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11, 16]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 3.0, directed := false, equicost := false) GROUP BY 1 ORDER BY 1;
----
11	13
16	10

# Distance 0 keeps the roots only.
query IIR
SELECT start_vid, node, agg_cost FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := 0.0, directed := true, equicost := false);
----
11	11	0

# The .c layer's check (src/driving_distance/driving_distance.c), verbatim, before any input is read.
statement error
SELECT * FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges,
          [11]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges',
  driver := 'driving_distance', distance := -1.0, directed := true, equicost := false);
----
Invalid Input Error: Negative value found on 'distance'
HINT: Must be positive

statement error
SELECT * FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 0) e) AS edges,
          [11]::BIGINT[] AS roots),
  edges_sql := 'SELECT id, source, target, cost, reverse_cost FROM edges WHERE id < 0',
  driver := 'driving_distance', distance := -0.5);
----
Negative value found on 'distance'

# STRICT: a NULL argument means the function is never entered, so nothing is checked.
query I
SELECT count(*) FROM _pgr_exec((SELECT NULL AS edges), edges_sql := '', driver := 'driving_distance',
  distance := -1.0, null_input := true);
----
0

# The roots column must be an id list, like starts and ends.
statement error
SELECT * FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT id, source, target, cost FROM edges) e) AS edges, 'x' AS roots),
  edges_sql := 'SELECT id, source, target, cost FROM edges', driver := 'driving_distance', distance := 1.0);
----
_pgr_exec: column 'roots' must be LIST(BIGINT)

# More rows than one DuckDB vector: 5001 on a chain from 1. seq keeps counting across every
# 2048-row chunk, and vertex i sits at depth i - 1.
statement ok
CREATE TABLE long_chain AS
SELECT i AS id, i AS source, i + 1 AS target, 1.0 AS cost FROM range(1, 5001) t(i);

query IIIII
SELECT count(*), count(DISTINCT seq), max(seq), max(depth), count(*) FILTER (WHERE depth <> node - 1)
FROM _pgr_exec(
  (SELECT (SELECT list(e) FROM (SELECT * FROM long_chain) e) AS edges, [1]::BIGINT[] AS roots),
  edges_sql := 'SELECT * FROM long_chain', driver := 'driving_distance', distance := 1e9);
----
5001	5001	5001	5000	0
