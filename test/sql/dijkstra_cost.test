# name: test/sql/dijkstra_cost.test
# description: dijkstraCost and dijkstraCostMatrix: shape, STRICT, agreement with dijkstra
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

statement ok
CREATE MACRO e() AS 'SELECT id, source, target, cost, reverse_cost FROM edges';

# The Cost shape is three columns, as upstream's OUT parameters declare.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM dijkstraCost(e(), 6, 10));
----
start_vid	BIGINT
end_vid	BIGINT
agg_cost	DOUBLE

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM dijkstraCostMatrix(e(), [5, 6, 10]));
----
start_vid	BIGINT
end_vid	BIGINT
agg_cost	DOUBLE

# The empty STRICT result keeps the three columns.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM dijkstraCost(NULL, 6, 10));
----
3

query I
SELECT count(*) FROM dijkstraCost(e(), 6, 10, directed := NULL);
----
0

# One-to-one: the cost is the agg_cost of dijkstra's closing row.
query IIR
SELECT * FROM dijkstraCost(e(), 6, 10);
----
6	10	5

# Every other signature agrees with dijkstra's closing rows (edge = -1), both ways round.
# Many-to-one runs with normal = true here and normal = false in dijkstra; the totals must agree.
query I
SELECT count(*) FROM (
  (SELECT start_vid, end_vid, agg_cost FROM dijkstra(e(), [6, 7], [10, 11]) WHERE edge = -1
   EXCEPT SELECT * FROM dijkstraCost(e(), [6, 7], [10, 11]))
  UNION ALL
  (SELECT * FROM dijkstraCost(e(), [6, 7], [10, 11])
   EXCEPT SELECT start_vid, end_vid, agg_cost FROM dijkstra(e(), [6, 7], [10, 11]) WHERE edge = -1));
----
0

query I
SELECT count(*) FROM (
  (SELECT start_vid, end_vid, agg_cost FROM dijkstra(e(), [6, 7], 10) WHERE edge = -1
   EXCEPT SELECT * FROM dijkstraCost(e(), [6, 7], 10))
  UNION ALL
  (SELECT * FROM dijkstraCost(e(), [6, 7], 10)
   EXCEPT SELECT start_vid, end_vid, agg_cost FROM dijkstra(e(), [6, 7], 10) WHERE edge = -1));
----
0

# The combinations form with a positional directed binds without ambiguity (VARCHAR, VARCHAR,
# BOOLEAN) and returns the undirected cost.
query IIR
SELECT * FROM dijkstraCost(e(), 'SELECT 6 AS source, 10 AS target', false);
----
6	10	1

# CostMatrix is dijkstraCost over every ordered pair of distinct ids.
query I
SELECT count(*) FROM (
  (SELECT * FROM dijkstraCostMatrix(e(), [5, 6, 10])
   EXCEPT SELECT * FROM dijkstraCost(e(), [5, 6, 10], [5, 6, 10]))
  UNION ALL
  (SELECT * FROM dijkstraCost(e(), [5, 6, 10], [5, 6, 10])
   EXCEPT SELECT * FROM dijkstraCostMatrix(e(), [5, 6, 10])));
----
0

query I
SELECT count(*) FROM dijkstraCostMatrix(e(), [5, 6, 10]);
----
6
