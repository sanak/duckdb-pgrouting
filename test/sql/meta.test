# name: test/sql/meta.test
# description: Meta functions of the routing extension
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

query T
SELECT DuckDB_pgRouting_Version();
----
4.0.2

query T
SELECT list_contains(list(function_name), 'dijkstra')
FROM duckdb_functions() WHERE function_name = 'dijkstra';
----
true

query TT
SELECT function_name, tags['pgrouting_name']
FROM duckdb_functions()
WHERE tags['ext'] = 'routing' AND tags['pgrouting_name'] IS NOT NULL
GROUP BY ALL ORDER BY 1, 2;
----
dijkstra	pgr_dijkstra
dijkstraCost	pgr_dijkstraCost
dijkstraCostMatrix	pgr_dijkstraCostMatrix
dijkstraNear	pgr_dijkstraNear
dijkstraNearCost	pgr_dijkstraNearCost
withPoints	pgr_withPoints
withPointsCost	pgr_withPointsCost
withPointsCostMatrix	pgr_withPointsCostMatrix

# The GROUP BY ALL query above collapses every overload's tags to one row and so cannot catch a
# dropped variant. PostgreSQL accepts any leading run of an overload's DEFAULT parameters
# positionally as well as by name, and DuckDB never matches a named parameter positionally, so a
# signature with k defaulted parameters is registered as k + 1 variants, each taking the first
# 0..k of them positionally and all of them by name. pgr_dijkstra has one defaulted parameter
# (`directed`) and five signatures, so this catalog must carry exactly ten "dijkstra" entries. The
# routing tag scopes the count to this extension's own registrations, so another extension that
# also published a function named `dijkstra` cannot fail this spuriously.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name = 'dijkstra' AND tags['ext'] = 'routing';
----
10
