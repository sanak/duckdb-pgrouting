# name: test/sql/meta.test
# description: Meta functions of the routing extension
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

query T
SELECT DuckDB_pgRouting_Version();
----
4.0.2

query T
SELECT list_contains(list(function_name), 'dijkstra')
FROM duckdb_functions() WHERE function_name = 'dijkstra';
----
true

query TT
SELECT function_name, tags['pgrouting_name']
FROM duckdb_functions()
WHERE tags['ext'] = 'routing' AND tags['pgrouting_name'] IS NOT NULL
GROUP BY ALL ORDER BY 1, 2;
----
dijkstra	pgr_dijkstra

# The GROUP BY ALL query above collapses every overload's tags to one row and so cannot catch a
# dropped variant. pgr_dijkstra's five signatures are each registered twice (once with `directed`
# as a named parameter, once with it appended as a trailing positional BOOLEAN, since DuckDB never
# matches a named parameter positionally), so this catalog must carry exactly ten "dijkstra"
# entries. The routing tag scopes the count to this extension's own registrations, so another
# extension that also published a function named `dijkstra` cannot fail this spuriously.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name = 'dijkstra' AND tags['ext'] = 'routing';
----
10
