# name: test/sql/hawick_circuits.test
# description: pgr_hawickCircuits: CIRCUITS rows, self-loops, parallel edges, order dependence, long answers
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_hawickCircuits('SELECT * FROM edges'));
----
seq	INTEGER
path_id	INTEGER
path_seq	INTEGER
start_vid	BIGINT
end_vid	BIGINT
node	BIGINT
edge	BIGINT
cost	DOUBLE
agg_cost	DOUBLE

# A two-way triangle: five circuits, each closed by a row of edge -1 back at its start; path_seq
# counts from 0.
query IIIIIIIRR
SELECT * FROM pgr_hawickCircuits('SELECT * FROM (VALUES (1, 1, 2, 1.0, 1.0), (2, 2, 3, 2, 2), (3, 3, 1, 3, 3))
  t(id, source, target, cost, reverse_cost)');
----
1	1	0	1	1	1	1	1	0
2	1	1	1	1	2	1	1	1
3	1	2	1	1	1	-1	0	2
4	2	0	1	1	1	1	1	0
5	2	1	1	1	2	2	2	1
6	2	2	1	1	3	3	3	3
7	2	3	1	1	1	-1	0	6
8	3	0	1	1	1	3	3	0
9	3	1	1	1	3	3	3	3
10	3	2	1	1	1	-1	0	6
11	4	0	1	1	1	3	3	0
12	4	1	1	1	3	2	2	3
13	4	2	1	1	2	1	1	5
14	4	3	1	1	1	-1	0	6
15	5	0	2	2	2	2	2	0
16	5	1	2	2	3	2	2	2
17	5	2	2	2	2	-1	0	4

# Upstream's q1 over the sample graph: which vertex each circuit starts at, and so the numbering,
# depends on the edge order (its transcript comes from another order), but the circuits do not:
# 94 rows, 20 circuits, the same total cost and the same circuit lengths, in either order.
query IIRT
WITH t AS MATERIALIZED (SELECT * FROM pgr_hawickCircuits('SELECT id, source, target, cost, reverse_cost FROM edges'))
SELECT count(*), count(DISTINCT path_id), sum(cost),
       (SELECT list(n ORDER BY n) FROM (SELECT count(*) - 1 AS n FROM t GROUP BY path_id))
FROM t;
----
94	20	74	[2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 4, 4, 6, 6, 6, 8, 8, 8]

query IIRT
WITH t AS MATERIALIZED (SELECT * FROM _pgr_exec((SELECT (SELECT list(e ORDER BY id DESC) FROM (
  SELECT id, source, target, cost, reverse_cost FROM edges) e) AS edges), edges_sql := 'reversed',
  driver := 'hawick_circuits'))
SELECT count(*), count(DISTINCT path_id), sum(cost),
       (SELECT list(n ORDER BY n) FROM (SELECT count(*) - 1 AS n FROM t GROUP BY path_id))
FROM t;
----
94	20	74	[2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 4, 4, 6, 6, 6, 8, 8, 8]

# A directed self-loop is a circuit of one edge.
query IIIIIIIRR
SELECT * FROM pgr_hawickCircuits('SELECT * FROM (VALUES (1, 1, 1, 1.0, -1.0), (2, 1, 2, 1, 1))
  t(id, source, target, cost, reverse_cost)');
----
1	1	0	1	1	1	1	1	0
2	1	1	1	1	1	-1	0	1
3	2	0	1	1	1	2	1	0
4	2	1	1	1	2	2	1	1
5	2	2	1	1	1	-1	0	2

# Parallel edges: the circuit goes through the one inserted first, with its cost.
statement ok
CREATE TABLE parallel AS SELECT * FROM (VALUES (1, 1, 2, 5.0, -1.0), (2, 1, 2, 3, -1), (3, 2, 1, 1, -1))
  t(id, source, target, cost, reverse_cost);

query IIIIIIIRR
SELECT * FROM _pgr_exec((SELECT (SELECT list(e ORDER BY id) FROM parallel e) AS edges), edges_sql := 'parallel',
  driver := 'hawick_circuits');
----
1	1	0	1	1	1	1	5	0
2	1	1	1	1	2	3	1	5
3	1	2	1	1	1	-1	0	6

query IIIIIIIRR
SELECT * FROM _pgr_exec((SELECT (SELECT list(e ORDER BY id DESC) FROM parallel e) AS edges),
  edges_sql := 'parallel reversed', driver := 'hawick_circuits');
----
1	1	0	2	2	2	3	1	0
2	1	1	2	2	1	2	3	1
3	1	2	2	2	2	-1	0	4

# A graph without a circuit, no rows, and STRICT.
query III
SELECT (SELECT count(*) FROM pgr_hawickCircuits('SELECT * FROM (VALUES (1, 1, 2, 1.0, -1.0), (2, 2, 3, 1, -1),
          (3, 1, 3, 1, -1)) t(id, source, target, cost, reverse_cost)')),
       (SELECT count(*) FROM pgr_hawickCircuits('SELECT * FROM edges WHERE id < 0')),
       (SELECT count(*) FROM pgr_hawickCircuits(NULL::VARCHAR));
----
0	0	0

# More than one 2048-row output chunk: 1100 two-way edges are 1100 circuits of three rows each,
# numbered and kept whole across chunks.
statement ok
CREATE TABLE twoway1100 AS SELECT i AS id, 2 * i AS source, 2 * i + 1 AS target, 1.0 AS cost, 1.0 AS reverse_cost
FROM range(1, 1101) t(i);

query IIII
WITH t AS MATERIALIZED (SELECT * FROM pgr_hawickCircuits('SELECT * FROM twoway1100'))
SELECT count(*), max(seq), max(path_id),
       (SELECT count(*) FROM (SELECT path_id FROM t GROUP BY path_id
                              HAVING count(*) = 3 AND min(path_seq) = 0 AND max(path_seq) = 2))
FROM t;
----
3300	3300	1100	1100
