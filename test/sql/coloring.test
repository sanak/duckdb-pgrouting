require pgrouting

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES
  (1,5,6,1,1),(2,6,10,-1,1),(3,10,15,-1,1),(4,6,7,1,1),(5,10,11,1,-1),(6,1,3,1,1),
  (7,3,7,1,1),(8,7,11,1,1),(9,11,16,1,1),(10,7,8,1,1),(11,11,12,1,-1),(12,8,12,1,-1),
  (13,12,17,1,-1),(14,8,9,1,1),(15,16,17,1,1),(16,15,16,1,1),(17,2,4,1,1),(18,13,14,1,1);

query II
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name IN ('pgr_bipartite', 'pgr_edgeColoring', 'pgr_sequentialVertexColoring')
  AND tags['ext'] = 'pgrouting' GROUP BY ALL ORDER BY 1;
----
pgr_bipartite	1
pgr_edgeColoring	1
pgr_sequentialVertexColoring	1

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_bipartite(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
node	BIGINT
color	BIGINT

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_sequentialVertexColoring(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
node	BIGINT
color	BIGINT

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pgr_edgeColoring(
  'SELECT id, source, target, cost, reverse_cost FROM edges'));
----
edge	BIGINT
color	BIGINT

# Upstream's q1 of each. The three answers depend on the order the edges are read in; this is
# upstream's order, which the sample table here is inserted in.
query II
SELECT * FROM pgr_bipartite('SELECT id, source, target, cost, reverse_cost FROM edges') ORDER BY node;
