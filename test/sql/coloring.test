# What every valid answer shares, whatever the edge order: no usable edge joins two vertices of one
# color, and no two edges sharing a vertex share a color. Each function is called once (CTE,
# materialized) and self-joined, so two differently-ordered calls of the same function can never
# disagree with each other.
query II
SELECT
  (WITH c AS MATERIALIZED (
     SELECT * FROM pgr_bipartite('SELECT id, source, target, cost, reverse_cost FROM edges'))
   SELECT count(*) FROM edges e
     JOIN c a ON a.node = e.source
     JOIN c b ON b.node = e.target
   WHERE a.color = b.color),
  (WITH c AS MATERIALIZED (
     SELECT * FROM pgr_sequentialVertexColoring('SELECT id, source, target, cost, reverse_cost FROM edges'))
   SELECT count(*) FROM edges e
     JOIN c a ON a.node = e.source
     JOIN c b ON b.node = e.target
   WHERE a.color = b.color);
----
0	0

query I
WITH c AS MATERIALIZED (
  SELECT * FROM pgr_edgeColoring('SELECT id, source, target, cost, reverse_cost FROM edges'))
SELECT count(*) FROM edges e1 JOIN edges e2 ON e1.id < e2.id
  AND (e1.source IN (e2.source, e2.target) OR e1.target IN (e2.source, e2.target))
JOIN c c1 ON c1.edge = e1.id
JOIN c c2 ON c2.edge = e2.id
WHERE c1.color = c2.color;
----
0

# Upstream's q2 adds the edge 5 - 1, closing an odd cycle: no longer bipartite, no rows (its q3).
query I
SELECT count(*) FROM pgr_bipartite(
  'SELECT id, source, target, cost, reverse_cost FROM edges UNION ALL SELECT 19, 5, 1, 1, 1');
----
0

# More than one 2048-row output chunk: a path of 3000 vertices alternates two colors.
statement ok
CREATE TABLE long_path AS SELECT i AS id, i AS source, i + 1 AS target, 1.0 AS cost, 1.0 AS reverse_cost
FROM range(1, 3000) t(i);

query III
SELECT count(*), count(DISTINCT color), count(*) FILTER (WHERE color <> 2 - node % 2)
FROM pgr_sequentialVertexColoring('SELECT * FROM long_path');
----
3000	2	0

query III
SELECT (SELECT count(*) FROM pgr_bipartite(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_sequentialVertexColoring(NULL::VARCHAR)),
       (SELECT count(*) FROM pgr_edgeColoring(NULL::VARCHAR));
----
0	0	0
