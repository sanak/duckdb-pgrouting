# name: test/sql/dijkstra_errors.test
# description: dijkstra error and message mapping
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require routing

statement ok
CREATE TABLE edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

statement ok
INSERT INTO edges VALUES (1, 1, 2, 1, 1), (2, 2, 3, 1, 1);

# A required column is missing: upstream's wording, verbatim. The "Invalid Input Error: " prefix
# pins the exception class DuckDB renders it as; the HINT line pins the "\nHINT: " joiner that
# carries the offending query, as pgRouting's err/log pair does.
statement error
SELECT * FROM dijkstra('SELECT id, source, target FROM edges', 1, 3);
----
Invalid Input Error: Column 'cost' not Found
HINT: SELECT id, source, target FROM edges

# A required column has the wrong class.
statement error
SELECT * FROM dijkstra('SELECT id, source, target, ''x'' AS cost FROM edges', 1, 3);
----
Invalid Input Error: Unexpected Column 'cost' type. Expected ANY-NUMERICAL

# A required column is NULL in some row.
statement error
SELECT * FROM dijkstra('SELECT id, source, NULL::BIGINT AS target, cost FROM edges', 1, 3);
----
Invalid Input Error: Unexpected Null value in column target

# No path: an empty result, not an error.
query I
SELECT count(*) FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 1, 99);
----
0

statement ok
CREATE TABLE no_edges (id BIGINT, source BIGINT, target BIGINT, cost DOUBLE, reverse_cost DOUBLE);

# An edges query that matches no rows is an ordinary empty result, not an error: upstream's driver
# emits a "No edges found" notice and returns with no error set. This is the not-yet-populated
# table version of that.
query I
SELECT count(*) FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM no_edges', 1, 3);
----
0

# ... and this is the filter-matches-nothing version, which is the common way a user meets it.
query I
SELECT count(*) FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges WHERE cost > 1000', 1, 3);
----
0

# A combinations query that matches no rows is the same: upstream emits "No (source, target) pairs
# found" and returns an empty result.
query I
SELECT count(*) FROM dijkstra(
  'SELECT id, source, target, cost, reverse_cost FROM edges',
  'SELECT 1 AS source, 2 AS target WHERE false');
----
0

# The column checks still run on an empty input, because they read the query's declared row shape
# rather than any row: same error wording as the populated case at the top of this file, with this
# query as the HINT.
statement error
SELECT * FROM dijkstra('SELECT id, source, target FROM no_edges', 1, 3);
----
Invalid Input Error: Column 'cost' not Found
HINT: SELECT id, source, target FROM no_edges
