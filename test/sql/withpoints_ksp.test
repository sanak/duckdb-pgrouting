# name: test/sql/withpoints_ksp.test
# description: pgr_withPointsKSP: variants, driving side, K checks, STRICT
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/edges.csv');

statement ok
CREATE TABLE pointsofinterest AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/pointsofinterest.csv');

statement ok
CREATE MACRO e() AS 'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id';

statement ok
CREATE MACRO p() AS 'SELECT pid, edge_id, fraction, side FROM pointsofinterest';

# Ten signatures, each with three defaulted parameters (directed, heap_paths, details): 10 x 4.
query II
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name = 'pgr_withPointsKSP' AND tags['ext'] = 'pgrouting' GROUP BY ALL;
----
pgr_withPointsKSP	40

# Upstream's q1 through the CHAR signatures' variants: two paths of cost 5.2.
query I
SELECT count(DISTINCT path_id) FROM pgr_withPointsKSP(e(), p(), -1, -2, 2, 'l')
UNION ALL SELECT count(DISTINCT path_id) FROM pgr_withPointsKSP(e(), p(), -1, -2, 2, 'l', true)
UNION ALL SELECT count(DISTINCT path_id) FROM pgr_withPointsKSP(e(), p(), -1, -2, 2, 'l', true, false)
UNION ALL SELECT count(DISTINCT path_id) FROM pgr_withPointsKSP(e(), p(), -1, -2, 2, 'l', true, false, false)
UNION ALL SELECT count(DISTINCT path_id) FROM pgr_withPointsKSP(e(), p(), -1, [-2], 2, 'l')
UNION ALL SELECT count(DISTINCT path_id) FROM pgr_withPointsKSP(e(), p(), [-1], -2, 2, 'l')
UNION ALL SELECT count(DISTINCT path_id) FROM pgr_withPointsKSP(e(), p(), [-1], [-2], 2, 'l', details := false);
----
2
2
2
2
2
2
2

query IR
SELECT path_id, round(agg_cost, 6) FROM pgr_withPointsKSP(e(), p(), -1, -2, 2, 'l') WHERE edge = -1 ORDER BY 1;
----
1	5.2
2	5.2

# Upstream's q2: the side in upper case.
query IR
SELECT end_vid, round(agg_cost, 6) FROM pgr_withPointsKSP(e(), p(), -1, [-3, 7], 2, 'B', directed := false)
WHERE edge = -1 ORDER BY 1, 2;
----
-3	3.2
-3	4
7	1.6
7	3.6

# Upstream's q3 (details) and q5 (combinations).
query IR
SELECT start_vid, round(agg_cost, 6) FROM pgr_withPointsKSP(e(), p(), [-1, 6], -3, 1, 'r', details := true)
WHERE edge = -1 ORDER BY 1;
----
-1	4
6	2.6

query IIR
SELECT start_vid, end_vid, round(agg_cost, 6)
FROM pgr_withPointsKSP(e(), p(), 'SELECT * FROM (VALUES (-1, 10), (6, -3)) AS combinations(source, target)',
                       2, 'r', details := true)
WHERE edge = -1 ORDER BY 1, 2, 3;
----
-1	10	6.4
-1	10	8.4
6	-3	2.6

# Without a side argument the side follows directed, as upstream's wrapper passes
# (CASE WHEN directed THEN 'r' ELSE 'b' END).
query I
SELECT count(*) FROM (
  (SELECT * FROM pgr_withPointsKSP(e(), p(), -1, -3, 2, details := true)
   EXCEPT SELECT * FROM pgr_withPointsKSP(e(), p(), -1, -3, 2, 'r', details := true))
  UNION ALL
  (SELECT * FROM pgr_withPointsKSP(e(), p(), -1, [-3, 7], 2, false)
   EXCEPT SELECT * FROM pgr_withPointsKSP(e(), p(), -1, [-3, 7], 2, 'b', false)));
----
0

# K = 0 finds nothing; K < 0 is upstream's error, after the side check.
query I
SELECT count(*) FROM pgr_withPointsKSP(e(), p(), -1, -2, 0, 'l');
----
0

statement error
SELECT * FROM pgr_withPointsKSP(e(), p(), -1, -2, -1, 'l');
----
Invalid Input Error: Invalid value of 'K'
HINT: Valid value are greater than 0

statement error
SELECT * FROM pgr_withPointsKSP(e(), p(), -1, -2, -1);
----
Invalid value of 'K'

statement error
SELECT * FROM pgr_withPointsKSP(e(), p(), -1, -2, -1, 'x');
----
Invalid Input Error: Invalid value of 'driving side'
HINT: Valid value are 'r', 'l', 'b'

# STRICT: a NULL anywhere gives no rows, and no check runs.
query I
SELECT count(*) FROM pgr_withPointsKSP(e(), p(), -1, -2, 2, NULL::VARCHAR)
UNION ALL SELECT count(*) FROM pgr_withPointsKSP(e(), p(), -1, -2, NULL::INTEGER, 'l')
UNION ALL SELECT count(*) FROM pgr_withPointsKSP(e(), p(), -1, -2, 2, 'l', heap_paths := NULL)
UNION ALL SELECT count(*) FROM pgr_withPointsKSP(e(), p(), -1, -2, 2, details := NULL)
UNION ALL SELECT count(*) FROM pgr_withPointsKSP(e(), NULL::VARCHAR, -1, -2, -1, 'x');
----
0
0
0
0
0
