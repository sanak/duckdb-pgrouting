# name: test/sql/dijkstra_long_input.test
# description: An input query longer than one DuckDB vector reaches pgRouting whole
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

# Every input query is materialized as one LIST(STRUCT) cell. With more rows than a DuckDB vector
# holds (2048), the list's child vectors are longer than any vector the executor normally hands
# out, which is the case a change to how those children are read would get wrong first. The cost
# column is DECIMAL on purpose: DECIMAL is converted to DOUBLE for the whole child column at once,
# so that conversion is exercised at the same length.
statement ok
CREATE TABLE long_chain AS
SELECT i AS id, i AS source, i + 1 AS target, 1.0::DECIMAL(4,1) AS cost
FROM range(1, 5001) t(i);

# 1 -> 5001 walks all 5000 edges: 5001 rows including the closing row, total cost 5000.
query III
SELECT count(*), max(seq), max(agg_cost)::BIGINT
FROM pgr_dijkstra('SELECT id, source, target, cost FROM long_chain', 1, 5001);
----
5001	5001	5000

# The last edge of the chain is reached, so no row was lost at a vector boundary.
query II
SELECT node, edge
FROM pgr_dijkstra('SELECT id, source, target, cost FROM long_chain', 1, 5001)
WHERE seq = 5000;
----
5000	5000

# Two paths in one result, 5001 + 5000 rows: seq keeps counting across every 2048-row output chunk,
# and path_seq restarts at 1 where the second path begins (seq 5002), then keeps counting across the
# next chunk boundary (seq 6144 -> 6145). Both are computed from the previous row, so they are what a
# chunk boundary would break first.
query III
SELECT seq, path_seq, start_vid
FROM pgr_dijkstra('SELECT id, source, target, cost FROM long_chain', [1, 2], [5001])
WHERE seq IN (2048, 2049, 5001, 5002, 6144, 6145)
ORDER BY seq;
----
2048	2048	1
2049	2049	1
5001	5001	1
5002	1	2
6144	1143	2
6145	1144	2
