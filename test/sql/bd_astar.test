# name: test/sql/bd_astar.test
# description: pgr_bdAstar, pgr_bdAstarCost, pgr_bdAstarCostMatrix: variants, checks, STRICT, long output
# group: [sql]

# SPDX-License-Identifier: GPL-2.0-or-later

require pgrouting

statement ok
CREATE TABLE edges AS SELECT * EXCLUDE (geom) FROM read_csv_auto('test/data/sampledata/edges.csv');

statement ok
CREATE MACRO xy() AS 'SELECT id, source, target, cost, reverse_cost, x1, y1, x2, y2 FROM edges';

statement ok
CREATE MACRO plain() AS 'SELECT id, source, target, cost, reverse_cost FROM edges';

query II
SELECT function_name, count(*) FROM duckdb_functions()
WHERE function_name IN ('pgr_bdAstar', 'pgr_bdAstarCost', 'pgr_bdAstarCostMatrix') AND tags['ext'] = 'pgrouting'
GROUP BY ALL ORDER BY 1;
----
pgr_bdAstar	25
pgr_bdAstarCost	25
pgr_bdAstarCostMatrix	5

# Upstream's q2: 6 -> 12 costs 3.
query IIR
SELECT start_vid, end_vid, agg_cost FROM pgr_bdAstar(xy(), 6, 12, directed := true, heuristic := 2)
WHERE edge = -1;
----
6	12	3

# Upstream's q4: many-to-one, undirected; bdAstar has no normal and passes the arrays as given.
query IIR
SELECT start_vid, end_vid, agg_cost FROM pgr_bdAstar(xy(), [6, 8], 10, false, heuristic := 4)
WHERE edge = -1 ORDER BY start_vid;
----
6	10	1
8	10	3

# With heuristic 0 the bidirectional A* is a bidirectional Dijkstra, which must reach Dijkstra's
# optimum, directed and undirected. (With a heuristic, the bidirectional search's stopping rule is
# upstream's to guarantee; the documentation queries cover those.)
query I
SELECT count(*)
FROM pgr_bdAstarCost(xy(), [6, 1, 15], [10, 17, 3], heuristic := 0) a
FULL JOIN pgr_dijkstraCost(plain(), [6, 1, 15], [10, 17, 3]) d USING (start_vid, end_vid)
WHERE a.agg_cost IS DISTINCT FROM d.agg_cost;
----
0

query I
SELECT count(*)
FROM pgr_bdAstarCost(xy(), [6, 1, 15], [10, 17, 3], false, 0) a
FULL JOIN pgr_dijkstraCost(plain(), [6, 1, 15], [10, 17, 3], false) d USING (start_vid, end_vid)
WHERE a.agg_cost IS DISTINCT FROM d.agg_cost;
----
0

# Upstream's bdAstarCostMatrix q2 (skip-listed for the generator: a scalar subquery argument).
query IIR
SELECT * FROM pgr_bdAstarCostMatrix(xy(), [5, 6, 10, 15], directed := false, heuristic := 2) ORDER BY 1, 2;
----
5	6	1
5	10	2
5	15	3
6	5	1
6	10	1
6	15	2
10	5	2
10	6	1
10	15	1
15	5	3
15	6	2
15	10	1

statement error
SELECT * FROM pgr_bdAstar(xy(), 6, 12, heuristic := 6);
----
Invalid Input Error: Unknown heuristic
HINT: Valid values: 0~5

statement error
SELECT * FROM pgr_bdAstarCost(xy(), 6, 12, factor := -1);
----
Invalid Input Error: Factor value out of range
HINT: Valid values: positive non zero

statement error
SELECT * FROM pgr_bdAstarCostMatrix(xy(), [5, 6], epsilon := 0);
----
Invalid Input Error: Epsilon value out of range
HINT: Valid values: 1 or greater than 1

query I
SELECT count(*) FROM pgr_bdAstar(xy(), 6, NULL::BIGINT);
----
0

query I
SELECT count(*) FROM pgr_bdAstarCostMatrix(xy(), [5, 6], heuristic := NULL);
----
0

statement error
SELECT * FROM pgr_bdAstar(plain(), 6, 12);
----
Invalid Input Error: Column 'x1' not Found

statement ok
CREATE TABLE long_chain AS
SELECT i AS id, i AS source, i + 1 AS target, 1.0 AS cost,
       i::DOUBLE AS x1, 0.0 AS y1, (i + 1)::DOUBLE AS x2, 0.0 AS y2
FROM range(1, 5001) t(i);

query IIIII
SELECT count(*), count(*) FILTER (WHERE path_seq = 1), max(path_seq),
       max(seq) FILTER (WHERE start_vid = 1), min(seq) FILTER (WHERE start_vid = 2)
FROM pgr_bdAstar('SELECT * FROM long_chain', [1, 2], [5001]);
----
10001	2	5001	5001	5002

# Same chunk-boundary pin as astar.test: on this chain graph only one route exists between any
# pair, so the bidirectional search returns the same nodes in the same start-to-end order.
query IIII
SELECT seq, path_seq, start_vid, node
FROM pgr_bdAstar('SELECT * FROM long_chain', [1, 2], [5001])
WHERE seq IN (2048, 2049, 5001, 5002, 6144, 6145)
ORDER BY seq;
----
2048	2048	1	2048
2049	2049	1	2049
5001	5001	1	5001
5002	1	2	2
6144	1143	2	1144
6145	1144	2	1145
